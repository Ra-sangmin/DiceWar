}

.map-select__ad-btn:hover { scale: 1.03 1.03; }
.map-select__ad-btn:active { scale: 0.97 0.97; }

/* 원본 uGUI Button ColorTint disabledColor (0.784,0.784,0.784,0.502) */
.map-select__ad-btn:disabled {
    -unity-background-image-tint-color: rgba(200, 200, 200, 0.502);
