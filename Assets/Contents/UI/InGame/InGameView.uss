/* 원본은 BGImage(회색) 위에 ActiveImage(빨강)를 덮는 uGUI Toggle 이었다 → 틴트 교체로 대체 */
.area-editor__btn--toggle {
    -unity-background-image-tint-color: rgb(118, 118, 118);
}

.area-editor__btn--toggle.area-editor__btn--on {
    -unity-background-image-tint-color: rgb(255, 69, 73);
}

.area-editor__btn--get-area { left: 640.6px; width: 180px; }
.area-editor__btn--get-dice { left: 963.6px; width: 197.6px; }

.area-editor__btn-label {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    margin: 0;
    padding: 0;
    font-size: 26px;
    color: rgb(255, 255, 255);
    -unity-font-definition: url("/Assets/Contents/Font/GyeonggiTitle-Medium.ttf");
    -unity-font-style: normal;
    -unity-text-align: middle-center;
}

.area-editor__btn-label--dark {
    color: rgb(0, 0, 0);
}

.area-editor__player-icon {
    position: absolute;
    left: 832.3px;
    top: 48.1px;
    width: 73px;
    height: 78px;
    margin: 0;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    -unity-background-scale-mode: scale-to-fit;
    display: none;
}

.area-editor__player-my-text {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    margin: 0;
    padding: 0;
    font-size: 20px;
    color: rgb(255, 255, 255);
    -unity-font-definition: url("/Assets/Contents/Font/GyeonggiTitle-Medium.ttf");
    -unity-font-style: normal;
    -unity-text-align: middle-center;
}

.area-editor__dice-icon {
    position: absolute;
    left: 1179.4px;
    top: 57.1px;
    width: 60px;
    height: 60px;
    margin: 0;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    -unity-background-scale-mode: scale-to-fit;
    display: none;
}


/* ===================================================================
   2026-10-14 인게임 HUD 미래지향 테마
   팝업 / 게임 설정과 같은 언어 : 짙은 남색 유리 + 시안 테두리, 각진 모서리(14), 시안 글리프.
   위의 원래 규칙은 그대로 두고 여기서 덮어쓴다 (같은 선택자 → 나중 규칙이 이김).
   =================================================================== */

/* ---------- 좌상단 도움말 / 우상단 메뉴 : 유리 사각 버튼 + 시안 글리프 ---------- */
.ingame-corner-btn {
    width: 120px;
    height: 120px;
    border-width: 2px;
    border-radius: 14px;
    border-color: rgba(120, 225, 230, 0.5);
    background-color: rgba(12, 22, 36, 0.88);
}

.ingame-corner-btn--tutorial {
    left: 22px;
    top: 18px;
    background-image: url("/Assets/Contents/Image/Button/icon_help_glyph.png");
}

.ingame-corner-btn--option {
    right: 18px;
    top: 18px;
    background-image: url("/Assets/Contents/Image/Button/icon_menu_glyph.png");
}

/* ---------- 타이머 : 시안 링 (Timer.cs 가 fill 이미지를 부채꼴로 그린다 → 링 이미지라 원호 진행 표시가 된다) ---------- */
.timer__inactive {
    background-image: url("/Assets/Contents/Image/BG/InGame/timer_track_future.png");
    -unity-background-image-tint-color: rgb(150, 165, 178);
    opacity: 0.75;
}

.timer__active {
    background-image: url("/Assets/Contents/Image/BG/InGame/timer_track_future.png");
}

.timer__fill {
    background-image: url("/Assets/Contents/Image/BG/InGame/timer_fg_future.png");
}

/* ---------- 스킬 메뉴 (배신 / 동맹 / 판매 / 구매 / 취소) ---------- */
.skill-menu-btn {
    border-width: 2px;
    border-radius: 14px;
}

.skill-menu-btn--normal {
    border-color: rgba(120, 225, 230, 0.6);
    background-color: rgb(12, 22, 36);
    background-image: linear-gradient(to bottom, rgb(36, 74, 116), rgb(12, 24, 40));
}

.skill-menu-btn--cancel {
    border-color: rgba(170, 200, 215, 0.28);
    background-color: rgb(30, 38, 50);
    background-image: linear-gradient(to bottom, rgb(48, 58, 72), rgb(22, 28, 38));
    -unity-slice-left: 0;
    -unity-slice-right: 0;
    -unity-slice-top: 0;
    -unity-slice-bottom: 0;
}

.skill-menu-btn--cancel .skill-menu-btn__label {
    color: rgb(214, 226, 234);
}

/* ---------- 맵 선택 바 : 바꾸기(-1) 버튼도 시안 유리 + 어두운 가격 칩 ---------- */
.map-select__play-btn {
    border-width: 2px;
    border-radius: 18px;
    border-color: rgba(120, 225, 230, 0.7);
    background-color: rgb(12, 24, 40);
    background-image: linear-gradient(to bottom, rgb(40, 84, 128), rgb(12, 26, 44));
    -unity-background-image-tint-color: rgb(255, 255, 255);
    -unity-slice-left: 0;
    -unity-slice-right: 0;
    -unity-slice-top: 0;
    -unity-slice-bottom: 0;
}

.map-select__play-label {
    color: rgb(226, 248, 251);
}

.map-select__need-coin-panel {
    border-width: 1px;
    border-radius: 10px;
    border-color: rgba(255, 210, 110, 0.45);
    background-color: rgba(4, 10, 18, 0.75);
    background-image: none;
}

.map-select__need-coin-text {
    color: rgb(255, 226, 150);
}

/* ---------- 플레이어 상세 패널 (아이콘 클릭 시 펼쳐짐) ---------- */
.player-data-panel {
    border-width: 2px;
    border-radius: 16px;
    border-color: rgba(120, 225, 230, 0.4);
    background-color: rgba(10, 18, 30, 0.9);
    background-image: linear-gradient(to bottom, rgba(30, 56, 88, 0.92), rgba(10, 16, 26, 0.95));
    -unity-slice-left: 0;
    -unity-slice-right: 0;
    -unity-slice-top: 0;
    -unity-slice-bottom: 0;
}

.player-data__line {
    background-color: rgba(120, 225, 230, 0.3);
}

/* ---------- 동맹 / 거래 받기 바의 버튼 : 거절 = 짙은 유리, 수락 = 붉은 그라데이션 ---------- */
.approve-alliance__refuse-btn,
.alliance-approve__cancel-btn {
    border-width: 2px;
    border-radius: 14px;
    border-color: rgba(170, 200, 215, 0.3);
    background-color: rgb(30, 38, 50);
    background-image: linear-gradient(to bottom, rgb(50, 60, 75), rgb(22, 28, 38));
}

.approve-alliance__accept-btn {
    border-width: 2px;
    border-radius: 14px;
    border-color: rgba(255, 170, 170, 0.6);
    background-color: rgb(230, 52, 62);
    background-image: linear-gradient(to bottom, rgb(255, 96, 100), rgb(206, 36, 50));
}

/* ---------- 승인 팝업 (예전 ApprovePopup) ---------- */
.approve__contens-0,
.approve__contens-1 {
    border-width: 2px;
    border-radius: 16px;
    border-color: rgba(120, 225, 230, 0.32);
    background-color: rgba(10, 18, 30, 0.6);
    background-image: linear-gradient(to bottom, rgba(28, 54, 86, 0.55), rgba(10, 18, 30, 0.7));
    -unity-slice-left: 0;
    -unity-slice-right: 0;
    -unity-slice-top: 0;
    -unity-slice-bottom: 0;
}

.approve__contents-panel {
    background-image: none;
}

.approve__refuse-btn,
.approve__accept-btn {
    border-width: 2px;
    border-radius: 14px;
    -unity-background-image-tint-color: rgb(255, 255, 255);
    -unity-slice-left: 0;
    -unity-slice-right: 0;
    -unity-slice-top: 0;
    -unity-slice-bottom: 0;
}

.approve__refuse-btn {
    border-color: rgba(170, 200, 215, 0.3);
    background-color: rgb(30, 38, 50);
    background-image: linear-gradient(to bottom, rgb(50, 60, 75), rgb(22, 28, 38));
}

.approve__accept-btn {
    border-color: rgba(255, 170, 170, 0.6);
    background-color: rgb(230, 52, 62);
    background-image: linear-gradient(to bottom, rgb(255, 96, 100), rgb(206, 36, 50));
}

.approve__accept-btn:disabled {
    border-color: rgba(255, 255, 255, 0.14);
    background-color: rgb(64, 70, 78);
    background-image: linear-gradient(to bottom, rgb(84, 90, 98), rgb(56, 61, 68));
}

/* 여러 제안 넘기기 ‹ › : 유리 사각 + 시안 꺾쇠 */
.approve__nav-btn {
    width: 120px;
    height: 120px;
    bottom: 203.5px;
    border-width: 2px;
    border-radius: 14px;
    border-color: rgba(120, 225, 230, 0.5);
    background-color: rgba(12, 22, 36, 0.88);
    -unity-background-scale-mode: scale-to-fit;
}

.approve__nav-btn--before {
    left: 69px;
    background-image: url("/Assets/Contents/Image/Button/back_chevron.png");
}

.approve__nav-btn--after {
    left: 1631px;
    background-image: url("/Assets/Contents/Image/Button/next_chevron.png");
}

.approve__count-badge {
    left: 92px;
    top: -14px;
    border-width: 2px;
    border-color: rgba(255, 190, 190, 0.8);
}
