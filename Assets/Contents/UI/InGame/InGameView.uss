    background-image: url("/Assets/Contents/Image/BG/InGame/count=none.png");
}

/* ---------- 동맹 아이콘 (원본 PlayerAllianceIcon 프리팹 165x120) ---------- */
.player-alliance-icon {
    width: 165px;
    height: 120px;
    flex-shrink: 0;
}

.player-alliance-icon__fg {
    position: absolute;
    left: 34.4px;
    top: -27.9px;
    width: 95px;
    height: 100px;
    -unity-background-scale-mode: scale-to-fit;
}

.player-alliance-icon__fg--0 { background-image: url("/Assets/Contents/Image/BG/InGame/PlayerIcon/player_select_0.png"); }
.player-alliance-icon__fg--1 { background-image: url("/Assets/Contents/Image/BG/InGame/PlayerIcon/player_select_1.png"); }
.player-alliance-icon__fg--2 { background-image: url("/Assets/Contents/Image/BG/InGame/PlayerIcon/player_select_2.png"); }
.player-alliance-icon__fg--3 { background-image: url("/Assets/Contents/Image/BG/InGame/PlayerIcon/player_select_3.png"); }
.player-alliance-icon__fg--4 { background-image: url("/Assets/Contents/Image/BG/InGame/PlayerIcon/player_select_4.png"); }
.player-alliance-icon__fg--5 { background-image: url("/Assets/Contents/Image/BG/InGame/PlayerIcon/player_select_5.png"); }
.player-alliance-icon__fg--6 { background-image: url("/Assets/Contents/Image/BG/InGame/PlayerIcon/player_select_6.png"); }

.player-alliance-icon__coin {
    position: absolute;
    left: 40.6px;
    top: 90px;
    width: 40px;
    height: 40px;
    background-image: url("/Assets/Contents/Image/BG/Main/Coin.png");
    -unity-background-scale-mode: scale-to-fit;
}

.player-alliance-icon__text {
    position: absolute;
    left: 95.33px;
    top: 56.8px;
    width: 103.74px;
    height: 104px;
    margin: 0;
    padding: 0;
    font-size: 40px;
    color: rgb(255, 243, 241);
    -unity-font-definition: url("/Assets/Contents/Font/GyeonggiTitle-Medium.ttf");
    -unity-font-style: normal;
    -unity-text-align: middle-left;
}


/* ===================================================================
   동맹 승인 현황 바 (멀티 전용) — 원본 MyAllianceApproveController
   원본은 CanvasGroup.DOFade 로 페이드. USS transition 으로 대체한다.
   =================================================================== */
.alliance-approve-panel {
    position: absolute;
    /* 2026-10-13 : 가로 가운데 1920 폭, 세로 전체 — 안의 바는 아래쪽 기준 */
    left: 50%;
    margin-left: -960px;
    width: 1920px;
    top: 0;
    bottom: 0;
    opacity: 0;
    display: none;
    transition-property: opacity;
    transition-duration: 0.25s;
}

/* 동맹 제안 바 (2026-09-19 시안) — 화면 절대좌표. 시안 1243x786 기준 S = 1.6497
   바 1399x139 @ (211,747). 반투명이라 뒤의 맵이 비친다 */
.alliance-approve__bar {
    position: absolute;
    left: 211px;
    bottom: 194px;
    width: 1399px;
    height: 139px;
    /* 2026-10-14 : 반투명 유리판 — 뒤의 영토가 비쳐 보여야 바 아래 땅을 보고 누를 수 있다 (바는 picking-mode Ignore 라 터치는 통과) */
    border-width: 2px;
    border-radius: 28px;
    border-color: rgba(120, 225, 230, 0.32);
    background-color: rgba(10, 18, 30, 0.5);
    background-image: linear-gradient(to bottom, rgba(28, 54, 86, 0.45), rgba(10, 18, 30, 0.6));
}

.alliance-approve__title {
    position: absolute;
    left: 188px;
    top: 0;
    bottom: 0;
    width: 220px;
    margin: 0;
    padding: 0;
    font-size: 43px;
    color: rgb(255, 255, 255);
    -unity-font-definition: url("/Assets/Contents/Font/GyeonggiTitle-Medium.ttf");
    -unity-font-style: normal;
    -unity-text-align: middle-left;
}

/* 제안한 플레이어 아이콘 묶음 : btn_bg7.png (9슬라이스 30), 내용만큼 늘어난다 */
.alliance-approve__icon-panel {
    position: absolute;
    left: 394.3px;
    top: 26.5px;
    height: 87px;
    flex-direction: row;
    align-items: center;
    padding-left: 26px;
    padding-right: 15.3px;
    background-image: url("/Assets/Contents/Image/Button/btn_bg7.png");
    -unity-slice-left: 30;
    -unity-slice-right: 30;
    -unity-slice-top: 30;
    -unity-slice-bottom: 30;
}

/* 보상 : N + 코인 */
.alliance-approve__reward-panel {
    position: absolute;
    left: 795.2px;
    top: 0;
    bottom: 0;
    flex-direction: row;
    align-items: center;
}

.alliance-approve__reward {
    margin: 0;
    padding: 0;
    font-size: 39px;
    color: rgb(255, 255, 255);
    -unity-font-definition: url("/Assets/Contents/Font/GyeonggiTitle-Medium.ttf");
    -unity-font-style: normal;
    -unity-text-align: middle-left;
}

.alliance-approve__coin {
    width: 48px;
    height: 48px;
    margin-left: 11.6px;
    flex-shrink: 0;
    background-image: url("/Assets/Contents/Image/BG/Main/Coin.png");
    -unity-background-scale-mode: scale-to-fit;
}

/* 철회 버튼 */
.alliance-approve__cancel-btn {
    position: absolute;
    left: 1026.2px;
    top: 26.5px;
    width: 186px;
    height: 87px;
    margin: 0;
    padding: 0;
    border-width: 0;
    border-radius: 16px;
    background-color: rgb(69, 73, 79);
    transition-property: scale;
    transition-duration: 0.08s;
}

.alliance-approve__cancel-btn:hover { scale: 1.03 1.03; }
.alliance-approve__cancel-btn:active { scale: 0.97 0.97; }
.alliance-approve__cancel-btn:disabled { opacity: 0.55; }

.alliance-approve__cancel-label {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    margin: 0;
    padding: 0;
    font-size: 38px;
    color: rgb(255, 255, 255);
    -unity-font-definition: url("/Assets/Contents/Font/GyeonggiTitle-Medium.ttf");
    -unity-font-style: normal;
    -unity-text-align: middle-center;
}

/* Icon_0~6 : 47.45x50.7 에 scale 1.5, 간격 34.6 */
.alliance-approve__icon {
    width: 36.3px;
    height: 38.8px;
    margin-right: 7.7px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

/* -------------------------------------------------------------------
   결과 상태 (.alliance-approve--result) — 제안이 성립/거절되면 바가
   "아이콘 + 요청 승인 N/M" 작은 알약으로 바뀐다 (2026-09-19 시안)
   시안 1680x538, 게임화면 709x399 -> S = 2.7091 (턴 종료 버튼 / 메시지 바로 보정)
   알약 501 x 79 @ top 814.9 — 폭은 플레이어 수에 따라 달라지므로 **바(211..1610) 중앙**에 붙인다
   (left:50% 는 바 기준이다. 실측 657.5 / 시안 633.1 — 24px 차이)
   ------------------------------------------------------------------- */
.alliance-approve--result {
    background-image: none;
}

.alliance-approve--result .alliance-approve__title,
.alliance-approve--result .alliance-approve__reward-panel,
.alliance-approve--result .alliance-approve__cancel-btn {
    display: none;
}

.alliance-approve--result .alliance-approve__icon-panel {
    left: 50%;
    top: 67.9px;
    height: 79px;
    translate: -50% 0;
    padding-left: 24px;
