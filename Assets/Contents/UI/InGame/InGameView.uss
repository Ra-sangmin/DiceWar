/* ===== 기본 폰트 (경기천년제목 Medium / normal, 2026-09-26 변경) =====
   개별 규칙이 없는 요소가 Unity 기본 테마 폰트(NotInter)로 떨어지지 않도록
   루트에 한 번 지정해 상속시킨다. (2026-09-19) */
:root {
    -unity-font-definition: url("/Assets/Contents/Font/GyeonggiTitle-Medium.ttf");
    -unity-font-style: normal;
}

/* ===== 인게임 화면 (UGUI Canvas → UI Toolkit 이식) =====
   좌표/크기는 기존 프리팹의 런타임 실측값을 그대로 옮긴 것이다. */

.ingame-root {
    flex-grow: 1;
    /* 원본 BGPanel 은 스프라이트 없는 검정 Image 였다 */
    background-color: rgb(0, 0, 0);
}

/* 배경(Snack bar.png).
   스프라이트(714x221)는 사방 41px 이 회색 그라디언트 테두리이고 안쪽은 균일한 어두운 면이다.
   url() 이 Texture2D 가 아니라 Sprite(Snack bar_0)로 해석되기 때문에
   -unity-slice-* 는 무시되고 스프라이트 border(0)만 쓰인다 → 9-slice 는 못 쓴다.
   대신 요소를 사방 400px 화면 밖으로 빼서 늘어난 테두리까지 전부 화면 밖에 놓는다.
   1080 높이 기준 세로 배율이 가장 커서 세로가 기준이 된다:
     테두리두께 = 41 * (1080 + 2*400) / 221 = 349px < 400px  → 화면에 안 보임
     가로는  41 * (1920 + 2*400) / 714 = 156px < 400px
   비율이 바뀌어도(세로형/울트라와이드) 둘 다 400px 아래로 유지된다. */
.ingame-bg {
    position: absolute;
    left: -400px;
    top: -400px;
    right: -400px;
    bottom: -400px;
    background-image: url("/Assets/Contents/Image/BG/InGame/Snack bar.png");
    -unity-background-scale-mode: stretch-to-fill;
}

/* ---------- 맵 레이어 ---------- */
.map-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* 맵 좌표의 기준점 (원본 ParantObj 중심) — 위치는 런타임에 translate 로 지정 */
.map-origin {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0;
    height: 0;
}

.map-sub-layer {
    position: absolute;
    left: 0;
    top: 0;
    width: 0;
    height: 0;
}

/* ---------- 육각 타일 ---------- */
.hexagon {
    position: absolute;
}

/* 원본 centerImage 는 부모 stretch + sizeDelta(4,0) → 좌우로 2px 씩 넓다 */
.hexagon__center {
    position: absolute;
    left: -2px;
    top: 0;
    right: -2px;
    bottom: 0;
    background-image: url("/Assets/Contents/Image/hexagon/hexagon.png");
    -unity-background-scale-mode: stretch-to-fill;
}

.hexagon__area-text {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    margin: 0;
    padding: 0;
    font-size: 36px;
    color: rgb(50, 50, 50);
    -unity-text-align: middle-center;
}

/* ---------- 영토 경계선 ---------- */
.hexagon-line {
    position: absolute;
}

/* 경계선 조각.
   원본 스프라이트(haxagonLineBg.png)는 양 끝이 뾰족한 렌즈 모양이라
   변 가운데가 굵고 꼭짓점 쪽이 가늘어져 굵기가 일정하지 않았다.
   스프라이트는 순수 흰색 + 알파라 색은 그대로 두고 단색 배경으로 대체한다.
   위치/길이/각도는 HexagonLineElement 가 타일 크기에서 계산해 넣는다
   (맵 크기마다 변의 각도가 달라서 USS 고정 회전값으로는 맞출 수 없다). */
.hexagon-line__seg {
    position: absolute;
    background-color: rgb(188, 188, 188);
}

/* ---------- 주사위 더미 ---------- */
.map-dice {
    position: absolute;
}

.map-dice__dice {
    position: absolute;
    background-image: url("/Assets/Contents/Image/dice/3Ddice_1.png");
    -unity-background-scale-mode: stretch-to-fill;
}

.map-dice__area-text {
    position: absolute;
    left: 0;
    top: 100px;
    width: 100px;
    margin: 0;
    padding: 0;
    font-size: 20px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
}

.map-dice__adj-text {
    position: absolute;
    left: 0;
    top: 124px;
    width: 100px;
    margin: 0;
    padding: 0;
    font-size: 16px;
    color: rgb(200, 200, 200);
    -unity-text-align: middle-center;
}

/* ---------- HUD 레이어 ---------- */
.hud-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* 좌상단 튜토리얼 / 우상단 옵션 버튼 (원본 138x139) */
.ingame-corner-btn {
    position: absolute;
    width: 138px;
    height: 139px;
    margin: 0;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    -unity-background-scale-mode: scale-to-fit;
    transition-property: scale;
    transition-duration: 0.08s;
}

.ingame-corner-btn:hover { scale: 1.05 1.05; }
.ingame-corner-btn:active { scale: 0.95 0.95; }

.ingame-corner-btn--tutorial {
    left: 15px;
    top: 10px;
    background-image: url("/Assets/Contents/Image/Button/icon buttons.png");
}

.ingame-corner-btn--option {
    right: 10px;
    top: 10px;
    background-image: url("/Assets/Contents/Image/Button/icon badge.png");
}

/* ---------- 우측 플레이어 현황 아이콘 ----------
   원본: PlayerIconPanel(anchor 우상단, pivot(1,1), anchoredPosition(-10,-170), width 100)
         VerticalLayoutGroup(spacing 10, UpperRight) */
.player-icon-panel {
    position: absolute;
    right: 10px;
    top: 170px;
    width: 100px;
    flex-direction: column;
    align-items: flex-end;
    /* 6.7 gap: 형제 간격 (2026-09-29) */
    gap: 10px;
}

/* 원본 PlayerIcon 138x93 (패널보다 넓어 왼쪽으로 삐져나온다) */
.player-icon {
    position: relative;
    width: 138px;
    height: 93px;
    flex-shrink: 0;
}

/* 내 턴 강조 (원본 210x150, 중앙 정렬) */
.player-icon__select {
    position: absolute;
    left: -36px;
    top: -28.5px;
    width: 210px;
    height: 150px;
    background-image: url("/Assets/Contents/Image/BG/InGame/player_state_bg_select_none.png");
    -unity-background-scale-mode: stretch-to-fill;
}

.player-icon__bg {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-image: url("/Assets/Contents/Image/BG/InGame/player_state_bg_none.png");
    -unity-background-scale-mode: stretch-to-fill;
}

/* 원본 sizeDelta(-4,-4) → 사방 2px 안쪽 */
.player-icon__center-bg {
    position: absolute;
    left: 2px;
    top: 2px;
    right: 2px;
    bottom: 2px;
    background-image: url("/Assets/Contents/Image/BG/InGame/player_state_bg_none.png");
    -unity-background-scale-mode: stretch-to-fill;
}

/* 원본 73x78, BG 좌하단 기준 (46, 46.4) */
.player-icon__icon {
    position: absolute;
    left: 9.5px;
    top: 7.6px;
    width: 73px;
    height: 78px;
    -unity-background-scale-mode: scale-to-fit;
}

.player-icon__icon--0 { background-image: url("/Assets/Contents/Image/BG/InGame/Icon_bg_0.png"); }
.player-icon__icon--1 { background-image: url("/Assets/Contents/Image/BG/InGame/Icon_bg_1.png"); }
.player-icon__icon--2 { background-image: url("/Assets/Contents/Image/BG/InGame/Icon_bg_2.png"); }
.player-icon__icon--3 { background-image: url("/Assets/Contents/Image/BG/InGame/Icon_bg_3.png"); }
.player-icon__icon--4 { background-image: url("/Assets/Contents/Image/BG/InGame/Icon_bg_4.png"); }
.player-icon__icon--5 { background-image: url("/Assets/Contents/Image/BG/InGame/Icon_bg_5.png"); }
.player-icon__icon--6 { background-image: url("/Assets/Contents/Image/BG/InGame/Icon_bg_6.png"); }

/* 연결 영토 수 (원본 61.5x92, 루트 중앙 기준 (32.4, 0.7)) */
.player-icon__count {
    position: absolute;
    left: 70.65px;
    top: -0.2px;
    width: 61.5px;
    height: 92px;
    margin: 0;
    padding: 0;
    font-size: 42px;
    color: rgb(244, 248, 252);
    -unity-font-definition: url("/Assets/Contents/Font/GyeonggiTitle-Medium.ttf");
    -unity-font-style: normal;
    -unity-text-align: middle-center;
}

/* ===================================================================
   인게임 하단 바 (NonePlayPanel)
   좌표는 실행 중인 원본에서 실측한 화면 좌표(1920x1080, 좌상단 기준)를 옮긴 값.
   컨테이너: left 0 / top 930 / 1920x150
   =================================================================== */
.none-play-panel {
    position: absolute;
    left: 0;
    top: 930px;
    width: 1920px;
    height: 150px;
    display: none;
}

/* bottom_bg.png (0,934 1920x142) */
.none-play__bg {
    position: absolute;
    left: 0;
    top: 4px;
    width: 1920px;
    height: 142px;
    background-image: url("/Assets/Contents/Image/BG/InGame/bottom_bg.png");
    -unity-background-scale-mode: stretch-to-fill;
}

/* bottom_bg2.png (140,958.5 1366.5x93) */
.none-play__message-bar {
    position: absolute;
    left: 140px;
    top: 28.5px;
    width: 1366.5px;
    height: 93px;
    background-image: url("/Assets/Contents/Image/BG/InGame/bottom_bg2.png");
    -unity-background-scale-mode: stretch-to-fill;
}

.none-play__intro-text {
    position: absolute;
    left: 154.2px;
    top: 13.5px;
    width: 1036.2px;
    height: 66px;
    margin: 0;
    padding: 0;
    font-size: 38px;
    color: rgb(255, 255, 255);
    -unity-font-definition: url("/Assets/Contents/Font/GyeonggiTitle-Medium.ttf");
    -unity-font-style: normal;
    -unity-text-align: middle-center;
}

/* ---------- 주사위 대결 ---------- */
.dice-war__row {
    position: absolute;
    top: 40px;
    width: 850px;
    height: 70px;
    flex-direction: row;
    align-items: center;
    /* 6.7 gap: 형제 간격 (2026-09-29) */
    gap: 20px;
    padding-left: 10px;
    padding-right: 10px;
}

/* 내 쪽: 오른쪽 정렬 + 역순 배치 (원본 HLG MiddleRight, reverse=true).
   row-reverse 에서는 flex-start 가 오른쪽이다. */
.dice-war__row--my {
    left: -140px;
    flex-direction: row-reverse;
    justify-content: flex-start;
}

/* 상대 쪽: 왼쪽 정렬 */
.dice-war__row--enemy {
    left: 950px;
    justify-content: flex-start;
}

.dice-war__dice {
    width: 55px;
    height: 55px;
    flex-shrink: 0;
    -unity-background-scale-mode: stretch-to-fill;
}

/* 원본 spacing 20 → 좌우 10px 씩 */

.dice-war__dice--1 { background-image: url("/Assets/Contents/Image/dice/dice01.png"); }
.dice-war__dice--2 { background-image: url("/Assets/Contents/Image/dice/dice02.png"); }
.dice-war__dice--3 { background-image: url("/Assets/Contents/Image/dice/dice03.png"); }
.dice-war__dice--4 { background-image: url("/Assets/Contents/Image/dice/dice04.png"); }
.dice-war__dice--5 { background-image: url("/Assets/Contents/Image/dice/dice05.png"); }
.dice-war__dice--6 { background-image: url("/Assets/Contents/Image/dice/dice06.png"); }

.dice-war__result {
    position: absolute;
    top: 25px;
    width: 100px;
    height: 100px;
    margin: 0;
    padding: 0;
    font-size: 60px;
    color: rgb(255, 255, 255);
    -unity-font-definition: url("/Assets/Contents/Font/GyeonggiTitle-Medium.ttf");
    -unity-font-style: normal;
    -unity-text-align: middle-center;
    transition-property: scale;
    transition-duration: 0.2s;
}

.dice-war__result--my { left: 720px; }
.dice-war__result--enemy { left: 840px; }

/* 승리쪽 강조 (원본 DOScale Yoyo) */
.dice-war__result--win { scale: 1.1 1.1; }

/* ---------- 스킬 카드 ---------- */
.skill-card__icon {
    position: absolute;
    left: 15px;
    top: 29.5px;
    width: 92px;
    height: 92px;
    -unity-background-scale-mode: scale-to-fit;
    background-image: url("/Assets/Contents/Image/BG/InGame/count=none.png");
}

.skill-card__icon--0 { background-image: url("/Assets/Contents/Image/BG/InGame/count=none.png"); }
.skill-card__icon--1 { background-image: url("/Assets/Contents/Image/BG/InGame/count=1.png"); }
.skill-card__icon--2 { background-image: url("/Assets/Contents/Image/BG/InGame/count=2.png"); }
.skill-card__icon--3 { background-image: url("/Assets/Contents/Image/BG/InGame/count=3.png"); }

/* 투명 클릭 영역 (원본 SkillBtn 120x120, alpha 0) */
.skill-card__btn {
    position: absolute;
    left: 13.2px;
    top: 15px;
    width: 120px;
    height: 120px;
    margin: 0;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

/* 스킬 메뉴 (원본 BtnPanel 100x413, VLG spacing 10 LowerCenter) */
.skill-btn-panel {
    position: absolute;
    left: 89px;
    top: -421.1px;
    width: 100px;
    height: 413.1px;
    flex-direction: column;
    justify-content: flex-end;
    align-items: center;
    display: none;
}

.skill-menu-btn {
    width: 250px;
    height: 92px;
    margin: 5px 0;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    flex-shrink: 0;
    display: none;
}

.skill-menu-btn--normal {
    background-image: url("/Assets/Contents/Image/Button/btn_bg4.png");
    -unity-background-scale-mode: stretch-to-fill;
}

.skill-menu-btn--cancel {
    background-image: url("/Assets/Contents/Image/Button/btn_bg2.png");
    -unity-slice-left: 30;
    -unity-slice-right: 30;
    -unity-slice-top: 30;
    -unity-slice-bottom: 30;
}

.skill-menu-btn__label {
    flex-grow: 1;
    margin: 0;
    padding: 0;
    font-size: 45px;
    color: rgb(135, 233, 244);
    -unity-font-definition: url("/Assets/Contents/Font/GyeonggiTitle-Medium.ttf");
    -unity-font-style: normal;
    -unity-text-align: middle-center;
}

/* ---------- 타이머 (원본 1534.6,962.8 82x82) ---------- */
.timer {
    position: absolute;
    left: 1534.6px;
    top: 32.8px;
    width: 82px;
    height: 82px;
}

.timer__inactive {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-image: url("/Assets/Contents/Image/BG/InGame/timer_bg2.png");
    -unity-background-scale-mode: stretch-to-fill;
}

.timer__active {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-image: url("/Assets/Contents/Image/BG/InGame/timer_bg.png");
    -unity-background-scale-mode: stretch-to-fill;
    display: none;
}

/* 원본 Fill Area 는 사방 6px 안쪽 */
.timer__fill-area {
    position: absolute;
    left: 6px;
    top: 6px;
    right: 6px;
    bottom: 6px;
}

/* 원본 Image(Filled / Radial360 / Top / Clockwise) 대체.
   UI Toolkit 에는 방사형 채우기가 없어서 Timer.cs 가 부채꼴 메시로 직접 그린다.
   아래 background-image 는 Timer.cs 가 스프라이트를 읽어가기 위한 것이고,
   읽은 뒤에는 코드가 배경을 지우고 메시로 대신 그린다. */
.timer__fill {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-image: url("/Assets/Contents/Image/BG/InGame/timer_fg.png");
    -unity-background-scale-mode: stretch-to-fill;
}

/* 카운트다운 남은 턴 (타이머 자리, 2026-10-08). 멀티에서 내 차례면 숨기고 타이머가 보인다 */
.timer__countdown {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    margin: 0;
    padding: 0;
    display: none;
    font-size: 48px;
    color: rgb(255, 214, 102);
    -unity-text-align: middle-center;
    -unity-font-definition: url("/Assets/Contents/Font/GyeonggiTitle-Bold.ttf");
    -unity-font-style: normal;
    text-shadow: 0 0 8px rgba(255, 170, 40, 0.85);
}

/* ---------- 턴 종료 버튼 (원본 1646.2,958.4 250x93.3) ---------- */
.end-turn-btn {
    position: absolute;
    left: 1646.2px;
    top: 28.4px;
    width: 250px;
    height: 93.3px;
    margin: 0;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    background-image: url("/Assets/Contents/Image/Button/btn_bg3.png");
    -unity-slice-left: 20;
    -unity-slice-right: 20;
    -unity-slice-top: 20;
    -unity-slice-bottom: 20;
    /* 원본 uGUI Button ColorTint : 활성 빨강 / 비활성 회색 */
    -unity-background-image-tint-color: rgb(255, 69, 73);
    transition-property: scale;
    transition-duration: 0.08s;
}

.end-turn-btn:hover { scale: 1.03 1.03; }
.end-turn-btn:active { scale: 0.97 0.97; }

.end-turn-btn:disabled {
    -unity-background-image-tint-color: rgb(94, 98, 104);
}

.end-turn-btn__label {
    flex-grow: 1;
    margin: 0;
    padding: 0;
    font-size: 44px;
    color: rgb(255, 255, 255);
    -unity-font-definition: url("/Assets/Contents/Font/GyeonggiTitle-Medium.ttf");
    -unity-font-style: normal;
    -unity-text-align: middle-center;
}

/* ---------- 비축 주사위 (원본 20,830 330x85) ---------- */
.stash-panel {
    position: absolute;
    left: 20px;
    top: -100px;
    width: 330px;
    height: 85px;
    opacity: 0;
}

.stash-panel__dice {
    position: absolute;
    left: 4px;
    top: 58.5px;
    width: 55px;
    height: 53px;
    background-image: url("/Assets/Contents/Image/dice/3Ddice_1.png");
    -unity-background-scale-mode: stretch-to-fill;
}

.stash-panel__text {
    position: absolute;
    left: 101.5px;
    top: 9.5px;
    width: 188px;
    height: 66px;
    margin: 0;
    padding: 0;
    font-size: 45px;
    color: rgb(255, 255, 255);
    -unity-font-definition: url("/Assets/Contents/Font/GyeonggiTitle-Medium.ttf");
    -unity-font-style: normal;
    -unity-text-align: middle-right;
}

/* ===================================================================
   맵 선택 패널 (게임 시작 전 하단 바) — 원본 MapSelectPanel
   부모 InGameBottomController(하단 stretch, h150) 기준 pos(0,42.5) 1133.2x221
   =================================================================== */
.map-select-panel {
    position: absolute;
    left: 50%;
    bottom: 66.5px;
    translate: -50% 0;
    width: 964px;
    height: 174px;
}

/* BG : Snack bar.png (border 80,60,80,60) 패널 전체 stretch */
.map-select__bg {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-image: url("/Assets/Contents/Image/BG/InGame/Snack bar.png");
    -unity-slice-left: 80;
    -unity-slice-right: 80;
    -unity-slice-top: 60;
    -unity-slice-bottom: 60;
}

/* "플레이어:" 텍스트 + 내 아이콘 (원본 Text pos(90,-3.5), 자식 Icon 은 우측 17px 간격) */
.map-select__player-row {
    position: absolute;
    left: 67.6px;
    top: 34.65px;
    flex-direction: row;
    align-items: center;
