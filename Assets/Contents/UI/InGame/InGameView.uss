}

/* ===================================================================
   InGameAreaEditor — 개발용 치트 패널 (Game_Multi 전용)
   [Conditional("UNITY_EDITOR")] / ("UNITY_STANDALONE_WIN") 이라 모바일에서는 동작하지 않는다.
   원본 실측 : OnBtn(1833,846) 70x70 / Panel(105,915) 1430x175
   =================================================================== */
.area-editor {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.area-editor__on-btn {
    position: absolute;
    left: 1833px;
    top: 846px;
    width: 70px;
    height: 70px;
    margin: 0;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    background-image: url("/Assets/Contents/Image/Button/old/settingBtn.png");
    -unity-background-scale-mode: scale-to-fit;
    display: none;
}

/* Snack bar 스프라이트는 서브에셋 border(80,60,80,60) 가 있어서 9슬라이스가 저절로 먹는다 */
.area-editor__panel {
    position: absolute;
    left: 105px;
    top: 915px;
    width: 1430px;
    height: 175px;
    background-image: url("/Assets/Contents/Image/BG/InGame/Snack bar.png");
    display: none;
}

.area-editor__btn {
    position: absolute;
    top: 52.5px;
    height: 70px;
    margin: 0;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    background-image: url("/Assets/Contents/Image/Button/btn_bg3.png");
    -unity-slice-left: 20;
    -unity-slice-right: 20;
    -unity-slice-top: 20;
    -unity-slice-bottom: 20;
}

.area-editor__btn--time {
    left: 80px;
    width: 220.3px;
    -unity-background-image-tint-color: rgb(95, 190, 248);
}

.area-editor__btn--skill {
    left: 360.3px;
    width: 220.3px;
    -unity-background-image-tint-color: rgb(245, 248, 95);
}

/* 원본은 BGImage(회색) 위에 ActiveImage(빨강)를 덮는 uGUI Toggle 이었다 → 틴트 교체로 대체 */
.area-editor__btn--toggle {
    -unity-background-image-tint-color: rgb(118, 118, 118);
