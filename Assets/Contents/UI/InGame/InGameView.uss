/* BeforeBtn / AfterBtn : back_btn.png 100x100 (AfterBtn 은 좌우 반전) */
.approve__nav-btn {
    position: absolute;
    /* 시안 '동맹 제안 받기_복수 제안' : 138x138, 바(752~890) 와 같은 높이 (2026-09-26) */
    top: 747.5px;
    width: 138px;
    height: 138px;
    margin: 0;
    padding: 0;
    display: none;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    -unity-background-scale-mode: stretch-to-fill;
    transition-property: scale;
    transition-duration: 0.08s;
}

.approve__nav-btn:hover { scale: 1.05 1.05; }
.approve__nav-btn:active { scale: 0.95 0.95; }

.approve__nav-btn--before {
    left: 60px;
