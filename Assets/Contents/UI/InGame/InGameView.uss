/* ===== 기본 폰트 (경기천년제목 Medium / normal, 2026-09-26 변경) =====
   개별 규칙이 없는 요소가 Unity 기본 테마 폰트(NotInter)로 떨어지지 않도록
   루트에 한 번 지정해 상속시킨다. (2026-09-19) */
:root {
    -unity-font-definition: url("/Assets/Contents/Font/GyeonggiTitle-Medium.ttf");
    -unity-font-style: normal;
}

/* ===== 인게임 화면 (UGUI Canvas → UI Toolkit 이식) =====
   좌표/크기는 기존 프리팹의 런타임 실측값을 그대로 옮긴 것이다. */

.ingame-root {
    flex-grow: 1;
    background-color: rgb(9, 12, 18);
}

/* ===== 배경 (2026-10-13 고급화) =====
   Intro / Main / Loading 과 같은 계열 : 짙은 남색 + 육각 무늬(흐리게) + 가운데 푸른 빛 + 가장자리 어둡게.
   예전 Snack bar.png 를 화면 밖까지 늘리던 방식은 버렸다. 세 겹 모두 루트 전체를 덮어 어떤 화면 비율에도 맞는다. */
.ingame-bg {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    /* 2026-10-14 : 미래지향 인게임 배경 (1920x1080 생성 이미지).
       짙은 남색 + 원근 바닥 그리드 + 지평선 빛 띠 + 옅은 회로선 + 가운데 HUD 링 + 빛 입자 + 스캔라인 + 비네트.
       이전 버전(색 구름 + 점 격자)은 ingame_bg_premium.png */
    background-image: url("/Assets/Contents/Image/BG/InGame/ingame_bg_future.png");
    -unity-background-scale-mode: scale-and-crop;
}

.ingame-glow {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-image: radial-gradient(ellipse at center, rgba(52, 110, 190, 0.08) 0%, rgba(0, 0, 0, 0) 70%);
}

.ingame-vignette {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-image: radial-gradient(ellipse at center, rgba(0, 0, 0, 0) 55%, rgba(0, 0, 0, 0.45) 100%);
}

/* ---------- 맵 레이어 ---------- */
.map-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* 맵 좌표의 기준점 (원본 ParantObj 중심) — 위치는 런타임에 translate 로 지정 */
.map-origin {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0;
    height: 0;
}

.map-sub-layer {
    position: absolute;
    left: 0;
    top: 0;
    width: 0;
    height: 0;
}

/* ---------- 육각 타일 ---------- */
.hexagon {
    position: absolute;
}

/* 원본 centerImage 는 부모 stretch + sizeDelta(4,0) → 좌우로 2px 씩 넓다 */
.hexagon__center {
    position: absolute;
    left: -2px;
    top: 0;
    right: -2px;
    bottom: 0;
    /* 2026-10-13 : 칸마다 은은한 입체 테두리가 있는 타일 (위쪽 밝고 아래쪽 어두운 베벨) → 영토 안에 입체적인 육각 선이 보인다.
       사용자가 고른 버전. 180px, 플레이어 색 틴트. 원본은 hexagon.png */
    background-image: url("/Assets/Contents/Image/hexagon/hexagon_premium.png");
    -unity-background-scale-mode: stretch-to-fill;
}

/* 영토가 없는 칸 (2026-10-13) : 보드판 격자. 맵 칸과 크기·위치가 같아서 배경 무늬처럼 어긋나지 않는다 */
.hexagon--empty .hexagon__center {
    left: 0;
    right: 0;
    background-image: url("/Assets/Contents/Image/hexagon/hexagon_empty.png");
    -unity-background-image-tint-color: rgba(140, 184, 242, 0.17);
}

.hexagon__area-text {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    margin: 0;
    padding: 0;
    font-size: 36px;
    color: rgb(50, 50, 50);
    -unity-text-align: middle-center;
}

/* ---------- 영토 경계선 ---------- */
.hexagon-line {
    position: absolute;
}

/* 경계선 조각.
   원본 스프라이트(haxagonLineBg.png)는 양 끝이 뾰족한 렌즈 모양이라
   변 가운데가 굵고 꼭짓점 쪽이 가늘어져 굵기가 일정하지 않았다.
   스프라이트는 순수 흰색 + 알파라 색은 그대로 두고 단색 배경으로 대체한다.
   위치/길이/각도는 HexagonLineElement 가 타일 크기에서 계산해 넣는다
   (맵 크기마다 변의 각도가 달라서 USS 고정 회전값으로는 맞출 수 없다). */
.hexagon-line__seg {
    position: absolute;
    /* 2026-10-13 : 회색 → 배경과 같은 짙은 남색. 영토가 섬처럼 또렷하게 나뉜다 */
    background-color: rgb(14, 19, 29);
}

/* ---------- 주사위 더미 ---------- */
.map-dice {
    position: absolute;
}

.map-dice__dice {
    position: absolute;
    /* 원본 주사위 그대로 (2026-10-13 : 3D 렌더 / 평면 주사위를 시도했지만 사용자가 원본을 선호 → 되돌림. 더미 아래 그림자만 추가) */
    background-image: url("/Assets/Contents/Image/dice/3Ddice_1.png");
    -unity-background-scale-mode: stretch-to-fill;
}

/* 주사위 더미 아래 부드러운 바닥 그림자 (2026-10-13). 첫 줄 맨 아래 주사위(중심 35,63.5 / 바닥 약 93) 기준 */
.map-dice__shadow {
    position: absolute;
    left: 6px;
    top: 78px;
    width: 60px;
    height: 26px;
    background-image: radial-gradient(ellipse at center, rgba(0, 0, 0, 0.3) 0%, rgba(0, 0, 0, 0) 70%);
}

/* 두 번째 줄(오른쪽 아래, 바닥 약 109)까지 덮도록 */
.map-dice__shadow--wide {
    width: 94px;
    height: 40px;
    top: 80px;
}

.map-dice__area-text {
    position: absolute;
    left: 0;
    top: 100px;
    width: 100px;
    margin: 0;
    padding: 0;
    font-size: 20px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
}

.map-dice__adj-text {
    position: absolute;
    left: 0;
    top: 124px;
    width: 100px;
    margin: 0;
    padding: 0;
    font-size: 16px;
    color: rgb(200, 200, 200);
    -unity-text-align: middle-center;
}

/* ---------- HUD 레이어 ---------- */
.hud-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* 좌상단 튜토리얼 / 우상단 옵션 버튼 (원본 138x139) */
.ingame-corner-btn {
    position: absolute;
    width: 138px;
    height: 139px;
    margin: 0;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    -unity-background-scale-mode: scale-to-fit;
    transition-property: scale;
    transition-duration: 0.08s;
}

.ingame-corner-btn:hover { scale: 1.05 1.05; }
.ingame-corner-btn:active { scale: 0.95 0.95; }

.ingame-corner-btn--tutorial {
    left: 15px;
    top: 10px;
    background-image: url("/Assets/Contents/Image/Button/icon buttons.png");
}

.ingame-corner-btn--option {
    right: 10px;
    top: 10px;
    background-image: url("/Assets/Contents/Image/Button/icon badge.png");
}

/* ---------- 우측 플레이어 현황 아이콘 ----------
   원본: PlayerIconPanel(anchor 우상단, pivot(1,1), anchoredPosition(-10,-170), width 100)
         VerticalLayoutGroup(spacing 10, UpperRight) */
.player-icon-panel {
    position: absolute;
    right: 10px;
    top: 170px;
    width: 100px;
    flex-direction: column;
    align-items: flex-end;
    /* 6.7 gap: 형제 간격 (2026-09-29) */
    gap: 10px;
}

/* 원본 PlayerIcon 138x93 (패널보다 넓어 왼쪽으로 삐져나온다) */
.player-icon {
    position: relative;
    width: 138px;
    height: 93px;
    flex-shrink: 0;
}

/* 내 턴 강조 (원본 210x150, 중앙 정렬) */
.player-icon__select {
    position: absolute;
    left: -36px;
    top: -28.5px;
    width: 210px;
    height: 150px;
    background-image: url("/Assets/Contents/Image/BG/InGame/player_state_bg_select_none.png");
    -unity-background-scale-mode: stretch-to-fill;
}

.player-icon__bg {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-image: url("/Assets/Contents/Image/BG/InGame/player_state_bg_none.png");
    -unity-background-scale-mode: stretch-to-fill;
}

/* 원본 sizeDelta(-4,-4) → 사방 2px 안쪽 */
.player-icon__center-bg {
    position: absolute;
    left: 2px;
    top: 2px;
    right: 2px;
    bottom: 2px;
    background-image: url("/Assets/Contents/Image/BG/InGame/player_state_bg_none.png");
    -unity-background-scale-mode: stretch-to-fill;
}

/* 원본 73x78, BG 좌하단 기준 (46, 46.4) */
.player-icon__icon {
    position: absolute;
    left: 9.5px;
    top: 7.6px;
    width: 73px;
    height: 78px;
    -unity-background-scale-mode: scale-to-fit;
}

.player-icon__icon--0 { background-image: url("/Assets/Contents/Image/BG/InGame/Icon_bg_0.png"); }
.player-icon__icon--1 { background-image: url("/Assets/Contents/Image/BG/InGame/Icon_bg_1.png"); }
.player-icon__icon--2 { background-image: url("/Assets/Contents/Image/BG/InGame/Icon_bg_2.png"); }
.player-icon__icon--3 { background-image: url("/Assets/Contents/Image/BG/InGame/Icon_bg_3.png"); }
.player-icon__icon--4 { background-image: url("/Assets/Contents/Image/BG/InGame/Icon_bg_4.png"); }
.player-icon__icon--5 { background-image: url("/Assets/Contents/Image/BG/InGame/Icon_bg_5.png"); }
.player-icon__icon--6 { background-image: url("/Assets/Contents/Image/BG/InGame/Icon_bg_6.png"); }

/* 연결 영토 수 (원본 61.5x92, 루트 중앙 기준 (32.4, 0.7)) */
.player-icon__count {
    position: absolute;
    left: 70.65px;
    top: -0.2px;
    width: 61.5px;
    height: 92px;
    margin: 0;
    padding: 0;
    font-size: 42px;
    color: rgb(244, 248, 252);
    -unity-font-definition: url("/Assets/Contents/Font/GyeonggiTitle-Medium.ttf");
    -unity-font-style: normal;
    -unity-text-align: middle-center;
}

/* ===================================================================
   인게임 하단 바 (NonePlayPanel)
   좌표는 실행 중인 원본에서 실측한 화면 좌표(1920x1080, 좌상단 기준)를 옮긴 값.
   컨테이너: left 0 / top 930 / 1920x150
   =================================================================== */
.none-play-panel {
    position: absolute;
    /* 2026-10-13 : 화면 비율 대응 — 아래쪽에 붙이고 가로 가운데 (예전 top 930 / left 0 은 폴드에서 화면 가운데, 와이드에서 왼쪽에 쏠렸다) */
    left: 50%;
    bottom: 0;
    margin-left: -960px;
    width: 1920px;
    height: 150px;
    display: none;
}

/* bottom_bg.png (0,934 1920x142) */
.none-play__bg {
    /* 하단 유리판 : 화면 양끝까지 (패널 밖으로 넓힌다) + 위쪽 가는 시안 선 (2026-10-13) */
    position: absolute;
    left: -1200px;
    right: -1200px;
    top: 4px;
    bottom: -40px;
    border-top-width: 1px;
    border-color: rgba(120, 225, 230, 0.25);
    background-image: linear-gradient(to bottom, rgba(10, 18, 30, 0.82), rgba(5, 9, 16, 0.96));
}

/* bottom_bg2.png (140,958.5 1366.5x93) */
.none-play__message-bar {
    /* 안내 문구 판 : Main 버튼과 같은 계열의 유리판 (2026-10-13) */
    position: absolute;
    left: 140px;
    top: 28.5px;
    width: 1366.5px;
    height: 93px;
    border-width: 2px;
    border-radius: 46px;
    border-color: rgba(120, 225, 230, 0.32);
    background-color: rgba(12, 22, 36, 0.85);
    background-image: linear-gradient(to bottom, rgba(28, 54, 86, 0.9), rgba(10, 18, 30, 0.92));
}

.none-play__intro-text {
    position: absolute;
    left: 154.2px;
    top: 13.5px;
    width: 1036.2px;
    height: 66px;
    margin: 0;
    padding: 0;
    font-size: 38px;
    color: rgb(255, 255, 255);
    -unity-font-definition: url("/Assets/Contents/Font/GyeonggiTitle-Medium.ttf");
    -unity-font-style: normal;
    -unity-text-align: middle-center;
}

/* ---------- 주사위 대결 ---------- */
.dice-war__row {
    position: absolute;
    top: 40px;
    width: 850px;
    height: 70px;
    flex-direction: row;
    align-items: center;
    /* 6.7 gap: 형제 간격 (2026-09-29) */
    gap: 20px;
    padding-left: 10px;
    padding-right: 10px;
}

/* 내 쪽: 오른쪽 정렬 + 역순 배치 (원본 HLG MiddleRight, reverse=true).
   row-reverse 에서는 flex-start 가 오른쪽이다. */
.dice-war__row--my {
    left: -140px;
    flex-direction: row-reverse;
    justify-content: flex-start;
}

/* 상대 쪽: 왼쪽 정렬 */
.dice-war__row--enemy {
    left: 950px;
    justify-content: flex-start;
}

.dice-war__dice {
    width: 55px;
    height: 55px;
    flex-shrink: 0;
    -unity-background-scale-mode: stretch-to-fill;
}

/* 원본 spacing 20 → 좌우 10px 씩 */

.dice-war__dice--1 { background-image: url("/Assets/Contents/Image/dice/dice01.png"); }
.dice-war__dice--2 { background-image: url("/Assets/Contents/Image/dice/dice02.png"); }
.dice-war__dice--3 { background-image: url("/Assets/Contents/Image/dice/dice03.png"); }
.dice-war__dice--4 { background-image: url("/Assets/Contents/Image/dice/dice04.png"); }
.dice-war__dice--5 { background-image: url("/Assets/Contents/Image/dice/dice05.png"); }
.dice-war__dice--6 { background-image: url("/Assets/Contents/Image/dice/dice06.png"); }

.dice-war__result {
    position: absolute;
    top: 25px;
    width: 100px;
    height: 100px;
    margin: 0;
    padding: 0;
    font-size: 60px;
    color: rgb(255, 255, 255);
    -unity-font-definition: url("/Assets/Contents/Font/GyeonggiTitle-Medium.ttf");
    -unity-font-style: normal;
    -unity-text-align: middle-center;
    transition-property: scale;
    transition-duration: 0.2s;
}

.dice-war__result--my { left: 720px; }
.dice-war__result--enemy { left: 840px; }

/* 승리쪽 강조 (원본 DOScale Yoyo) */
.dice-war__result--win { scale: 1.1 1.1; }

/* ---------- 스킬 카드 ---------- */
.skill-card__icon {
    position: absolute;
    left: 15px;
    top: 29.5px;
    width: 92px;
    height: 92px;
    -unity-background-scale-mode: scale-to-fit;
    background-image: url("/Assets/Contents/Image/BG/InGame/count=none.png");
}

.skill-card__icon--0 { background-image: url("/Assets/Contents/Image/BG/InGame/count=none.png"); }
.skill-card__icon--1 { background-image: url("/Assets/Contents/Image/BG/InGame/count=1.png"); }
.skill-card__icon--2 { background-image: url("/Assets/Contents/Image/BG/InGame/count=2.png"); }
.skill-card__icon--3 { background-image: url("/Assets/Contents/Image/BG/InGame/count=3.png"); }

/* 투명 클릭 영역 (원본 SkillBtn 120x120, alpha 0) */
.skill-card__btn {
    position: absolute;
    left: 13.2px;
    top: 15px;
    width: 120px;
    height: 120px;
    margin: 0;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

/* 스킬 메뉴 (원본 BtnPanel 100x413, VLG spacing 10 LowerCenter) */
.skill-btn-panel {
    position: absolute;
    left: 89px;
    top: -421.1px;
    width: 100px;
    height: 413.1px;
    flex-direction: column;
    justify-content: flex-end;
    align-items: center;
    display: none;
}

.skill-menu-btn {
    width: 250px;
    height: 92px;
    margin: 5px 0;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    flex-shrink: 0;
    display: none;
}

.skill-menu-btn--normal {
    background-image: url("/Assets/Contents/Image/Button/btn_bg4.png");
    -unity-background-scale-mode: stretch-to-fill;
}

.skill-menu-btn--cancel {
    background-image: url("/Assets/Contents/Image/Button/btn_bg2.png");
    -unity-slice-left: 30;
    -unity-slice-right: 30;
    -unity-slice-top: 30;
    -unity-slice-bottom: 30;
}

.skill-menu-btn__label {
    flex-grow: 1;
    margin: 0;
    padding: 0;
    font-size: 45px;
    color: rgb(135, 233, 244);
    -unity-font-definition: url("/Assets/Contents/Font/GyeonggiTitle-Medium.ttf");
    -unity-font-style: normal;
    -unity-text-align: middle-center;
}

/* ---------- 타이머 (원본 1534.6,962.8 82x82) ---------- */
.timer {
    position: absolute;
    left: 1534.6px;
    top: 32.8px;
    width: 82px;
    height: 82px;
}

.timer__inactive {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-image: url("/Assets/Contents/Image/BG/InGame/timer_bg2.png");
    -unity-background-scale-mode: stretch-to-fill;
}

.timer__active {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-image: url("/Assets/Contents/Image/BG/InGame/timer_bg.png");
    -unity-background-scale-mode: stretch-to-fill;
    display: none;
}

/* 원본 Fill Area 는 사방 6px 안쪽 */
.timer__fill-area {
    position: absolute;
    left: 6px;
    top: 6px;
    right: 6px;
    bottom: 6px;
}

/* 원본 Image(Filled / Radial360 / Top / Clockwise) 대체.
   UI Toolkit 에는 방사형 채우기가 없어서 Timer.cs 가 부채꼴 메시로 직접 그린다.
   아래 background-image 는 Timer.cs 가 스프라이트를 읽어가기 위한 것이고,
   읽은 뒤에는 코드가 배경을 지우고 메시로 대신 그린다. */
.timer__fill {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-image: url("/Assets/Contents/Image/BG/InGame/timer_fg.png");
    -unity-background-scale-mode: stretch-to-fill;
}

/* 카운트다운 남은 턴 (타이머 자리, 2026-10-08). 멀티에서 내 차례면 숨기고 타이머가 보인다 */
.timer__countdown {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    margin: 0;
    padding: 0;
    display: none;
    font-size: 48px;
    color: rgb(255, 214, 102);
    -unity-text-align: middle-center;
    -unity-font-definition: url("/Assets/Contents/Font/GyeonggiTitle-Bold.ttf");
    -unity-font-style: normal;
    text-shadow: 0 0 8px rgba(255, 170, 40, 0.85);
}

/* ---------- 턴 종료 버튼 (원본 1646.2,958.4 250x93.3) ---------- */
.end-turn-btn {
    position: absolute;
    left: 1646.2px;
    top: 28.4px;
    width: 250px;
    height: 93.3px;
    margin: 0;
    padding: 0;
    /* 2026-10-13 : 이미지(btn_bg3 + 틴트) 대신 붉은 그라데이션 + 밝은 테두리 */
    border-width: 2px;
    border-radius: 20px;
    border-color: rgba(255, 170, 170, 0.6);
    background-color: rgb(230, 52, 62);
    background-image: linear-gradient(to bottom, rgb(255, 96, 100), rgb(206, 36, 50));
    transition-property: scale;
    transition-duration: 0.08s;
}

.end-turn-btn:hover { scale: 1.03 1.03; }
.end-turn-btn:active { scale: 0.97 0.97; }

.end-turn-btn:disabled {
    border-color: rgba(255, 255, 255, 0.14);
    background-color: rgb(80, 86, 94);
    background-image: linear-gradient(to bottom, rgb(96, 102, 110), rgb(64, 69, 76));
}

.end-turn-btn__label {
    flex-grow: 1;
    margin: 0;
    padding: 0;
    font-size: 44px;
    letter-spacing: 2px;
    color: rgb(255, 255, 255);
    -unity-font-definition: url("/Assets/Contents/Font/GyeonggiTitle-Medium.ttf");
    -unity-font-style: normal;
    -unity-text-align: middle-center;
}

/* ---------- 비축 주사위 (원본 20,830 330x85) ---------- */
.stash-panel {
    /* 2026-10-14 : 비축 주사위 표시를 하단 바 바로 위 오른쪽(턴 종료 버튼 위)의 유리 알약으로.
       예전엔 배경 없이 글자가 맵 위에 겹치고 주사위 아이콘이 아래로 삐져나왔다. 왼쪽은 스킬 메뉴가 위로 펼쳐지는 자리라 오른쪽에 둔다.
       내용 길이에 맞춰 늘어난다. 숨김은 코드가 opacity 0/1 로 한다.
       2026-10-14 : 개발용 톱니 버튼을 왼쪽(스킬 카드 위)으로 옮겨서 오른쪽 끝(턴 종료 버튼 오른쪽 끝선)에 붙인다 */
    position: absolute;
    right: 24px;
    top: -76px;
    height: 64px;
    padding: 0 26px 0 14px;
    flex-direction: row;
    align-items: center;
    border-width: 2px;
    border-radius: 32px;
    border-color: rgba(120, 225, 230, 0.4);
    background-color: rgba(10, 18, 30, 0.82);
    background-image: linear-gradient(to bottom, rgba(32, 58, 94, 0.9), rgba(10, 15, 24, 0.92));
    opacity: 0;
}

.stash-panel__dice {
    width: 40px;
    height: 43px;
    margin-right: 12px;
    flex-shrink: 0;
    background-image: url("/Assets/Contents/Image/dice/3Ddice_1.png");
    -unity-background-scale-mode: scale-to-fit;
}

.stash-panel__text {
    margin: 0;
    padding: 0;
    font-size: 34px;
    white-space: nowrap;
    color: rgb(226, 248, 251);
    -unity-font-definition: url("/Assets/Contents/Font/GyeonggiTitle-Medium.ttf");
    -unity-font-style: normal;
    -unity-text-align: middle-left;
}

/* ===================================================================
   맵 선택 패널 (게임 시작 전 하단 바) — 원본 MapSelectPanel
   부모 InGameBottomController(하단 stretch, h150) 기준 pos(0,42.5) 1133.2x221
   =================================================================== */
.map-select-panel {
    position: absolute;
    left: 50%;
    /* 2026-10-14 : 더 아래로 (66.5 → -10). 보이는 판(.map-select__bg)이 패널 위아래 37px 안쪽이라 화면 바닥에서 27px 떨어진다 */
    bottom: -10px;
    translate: -50% 0;
    width: 964px;
    height: 174px;
}

/* BG : Snack bar.png (border 80,60,80,60) 패널 전체 stretch */
.map-select__bg {
    /* 2026-10-13 : Snack bar.png 대신 유리판. 세로는 내용(버튼 73)에 맞춰 얇게 — 패널(174) 위아래 37px 씩 비운다 */
    position: absolute;
    left: 0;
    top: 37px;
    right: 0;
    bottom: 37px;
    border-width: 2px;
    border-radius: 28px;
    border-color: rgba(120, 225, 230, 0.32);
    background-color: rgba(12, 22, 36, 0.9);
    background-image: linear-gradient(to bottom, rgba(28, 54, 86, 0.92), rgba(10, 18, 30, 0.95));
}

/* "플레이어:" 텍스트 + 내 아이콘 (원본 Text pos(90,-3.5), 자식 Icon 은 우측 17px 간격) */
.map-select__player-row {
    position: absolute;
    left: 67.6px;
    top: 34.65px;
    flex-direction: row;
    align-items: center;
}

.map-select__player-label {
    margin: 0;
    padding: 0;
    height: 106.7px;
    font-size: 48px;
    color: rgb(255, 255, 255);
    -unity-font-definition: url("/Assets/Contents/Font/GyeonggiTitle-Medium.ttf");
    -unity-font-style: normal;
    -unity-text-align: middle-left;
}

.map-select__player-icon {
    width: 73px;
    height: 78px;
    margin-left: 19px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.map-select__player-icon--0 { background-image: url("/Assets/Contents/Image/BG/InGame/Icon_bg_0.png"); }
.map-select__player-icon--1 { background-image: url("/Assets/Contents/Image/BG/InGame/Icon_bg_1.png"); }
.map-select__player-icon--2 { background-image: url("/Assets/Contents/Image/BG/InGame/Icon_bg_2.png"); }
.map-select__player-icon--3 { background-image: url("/Assets/Contents/Image/BG/InGame/Icon_bg_3.png"); }
.map-select__player-icon--4 { background-image: url("/Assets/Contents/Image/BG/InGame/Icon_bg_4.png"); }
.map-select__player-icon--5 { background-image: url("/Assets/Contents/Image/BG/InGame/Icon_bg_5.png"); }
.map-select__player-icon--6 { background-image: url("/Assets/Contents/Image/BG/InGame/Icon_bg_6.png"); }

/* ChangeBtn (원본 pos(75,-5) 330x93) — AdPlayBtn / PlayBtn 을 겹쳐 담는 컨테이너 */
/* 버튼 높이 73 은 의도적이다 — 시안은 93 이지만 사용자가 "위아래 10px 씩 줄여달라" 고 요청했다.
   (2026-09-19) 시안과 대조할 때 93 으로 되돌리지 말 것.
   높이를 다시 바꾸면 top(= 43 + (93-H)/2), 가격 배지 높이, 광고 아이콘/라벨 top 도 같이 맞춰야 한다. */
.map-select__change-group {
    position: absolute;
    left: 422.2px;
    top: 53px;
    width: 261px;
    height: 73px;
}

/* AdPlayBtn : 부모 stretch, sizeDelta(-6,-6) → 사방 3px 안쪽 (btn_bg4, ppu 1.3) */
.map-select__ad-btn {
    position: absolute;
    left: 3px;
    top: 3px;
    right: 3px;
    bottom: 3px;
    margin: 0;
    padding: 0;
    /* 2026-10-14 : 이미지(btn_bg4) → 시안 유리 버튼 (메인의 플레이 버튼과 같은 계열) */
    border-width: 2px;
    border-radius: 18px;
    border-color: rgba(120, 225, 230, 0.7);
    background-color: rgb(12, 24, 40);
    background-image: linear-gradient(to bottom, rgb(40, 84, 128), rgb(12, 26, 44));
    transition-property: scale;
    transition-duration: 0.08s;
}

.map-select__ad-btn:hover { scale: 1.03 1.03; }
.map-select__ad-btn:active { scale: 0.97 0.97; }

/* 원본 uGUI Button ColorTint disabledColor (0.784,0.784,0.784,0.502) */
.map-select__ad-btn:disabled {
    opacity: 0.5;
}

.map-select__ad-icon {
    position: absolute;
    left: 22px;
    top: 17px;
    width: 32px;
    height: 32px;
    background-image: url("/Assets/Contents/Image/Button/adIcon.png");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(139, 230, 234);
}

.map-select__ad-label {
    position: absolute;
    left: 62px;
    top: -16.5px;
    width: 176px;
    height: 100px;
    margin: 0;
    padding: 0;
    font-size: 36px;
    letter-spacing: 1px;
    color: rgb(226, 248, 251);
    -unity-font-definition: url("/Assets/Contents/Font/GyeonggiTitle-Medium.ttf");
    -unity-font-style: normal;
    -unity-text-align: middle-center;
}

/* PlayBtn : 부모 stretch (330x93), HorizontalLayoutGroup spacing 7.6 MiddleCenter */
.map-select__play-btn {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    margin: 0;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    background-image: url("/Assets/Contents/Image/Button/btn_bg3.png");
    -unity-slice-left: 20;
    -unity-slice-right: 20;
    -unity-slice-top: 20;
    -unity-slice-bottom: 20;
    -unity-background-image-tint-color: rgb(94, 98, 104);
    flex-direction: row;
    justify-content: center;
    align-items: center;
    transition-property: scale;
    transition-duration: 0.08s;
}

.map-select__play-btn:hover { scale: 1.03 1.03; }
.map-select__play-btn:active { scale: 0.97 0.97; }

.map-select__play-label {
    width: 96px;
    height: 100px;
    margin: 0;
    padding: 0;
    font-size: 40px;
    color: rgb(219, 223, 229);
    -unity-font-definition: url("/Assets/Contents/Font/GyeonggiTitle-Medium.ttf");
    -unity-font-style: normal;
    -unity-text-align: middle-center;
}

/* NeedCoinTextPanel : 112.1x65, btn_bg3 에 검정 27% */
.map-select__need-coin-panel {
    width: 101px;
    height: 57px;
    margin-left: 14px;
    flex-shrink: 0;
    background-image: url("/Assets/Contents/Image/Button/btn_bg3.png");
    -unity-slice-left: 20;
    -unity-slice-right: 20;
    -unity-slice-top: 20;
    -unity-slice-bottom: 20;
    /* 원본 검정 27% 는 Linear 색공간에서 시안(69,73,79)보다 밝게 합성된다 → 알파를 올려 맞춤 */
    -unity-background-image-tint-color: rgba(0, 0, 0, 0.468);
}

.map-select__need-coin-text {
    position: absolute;
    left: 6px;
    top: -2.25px;
    width: 80px;
    height: 61.5px;
    margin: 0;
    padding: 0;
    font-size: 47px;
    color: rgb(219, 223, 229);
    -unity-font-definition: url("/Assets/Contents/Font/GyeonggiTitle-Medium.ttf");
    -unity-font-style: normal;
    -unity-text-align: middle-left;
}

.map-select__coin-icon {
    position: absolute;
    left: 58.5px;
    top: 11px;
    width: 35px;
    height: 35px;
    background-image: url("/Assets/Contents/Image/BG/Main/Coin.png");
    -unity-background-scale-mode: scale-to-fit;
}

/* yesBtn (시작하기) : 원본 pos(380,-5) 220x93, btn_bg3 빨강 틴트 */
.map-select__yes-btn {
    position: absolute;
    left: 708.2px;
    top: 53px;
    width: 188px;
    height: 73px;
    margin: 0;
    padding: 0;
    /* 2026-10-13 : 턴 종료 버튼과 같은 붉은 그라데이션 */
    border-width: 2px;
    border-radius: 18px;
    border-color: rgba(255, 170, 170, 0.6);
    background-color: rgb(230, 52, 62);
    background-image: linear-gradient(to bottom, rgb(255, 96, 100), rgb(206, 36, 50));
    transition-property: scale;
    transition-duration: 0.08s;
}

.map-select__yes-btn:hover { scale: 1.03 1.03; }
.map-select__yes-btn:active { scale: 0.97 0.97; }

.map-select__yes-label {
    flex-grow: 1;
    margin: 0;
    margin-top: -1px;
    padding: 0;
    font-size: 39px;
    color: rgb(255, 255, 255);
    -unity-font-definition: url("/Assets/Contents/Font/GyeonggiTitle-Medium.ttf");
    -unity-font-style: normal;
    -unity-text-align: middle-center;
}


/* ===================================================================
   플레이어 상세 패널 (아이콘 클릭 시 좌측으로 펼쳐짐) — 원본 PlayerDataPanel
   원본 ContensPanel : HorizontalLayoutGroup(reverseArrangement) + ContentSizeFitter
   =================================================================== */
.player-data-panel {
    position: absolute;
    right: 180px;
    top: 200px;
    height: 204px;
    min-width: 150px;
    flex-direction: row-reverse;
    align-items: center;
    display: none;
    background-image: url("/Assets/Contents/Image/BG/InGame/bottom_bg2.png");
    -unity-slice-left: 30;
    -unity-slice-right: 30;
    -unity-slice-top: 30;
    -unity-slice-bottom: 30;
}

/* SkillCardPanel 150x205 (항상 가장 오른쪽) */
.player-data__skill-panel {
    width: 150px;
    height: 205px;
    flex-shrink: 0;
}

/* LineImage 2x127, 패널 왼쪽 끝 구분선 */
.player-data__line {
    position: absolute;
    left: 0.8px;
    top: 39px;
    width: 2px;
    height: 127px;
    background-color: rgb(94, 98, 104);
}

/* SkillCard 100x100 (원본 Icon_0~3 를 scale-to-fit 한 장으로 대체) */
.player-data__skill-icon {
    position: absolute;
    left: 25.2px;
    top: 47.5px;
    width: 100px;
    height: 100px;
