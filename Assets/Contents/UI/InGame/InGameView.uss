/* ===================================================================
   동맹 승인 현황 바 (멀티 전용) — 원본 MyAllianceApproveController
   원본은 CanvasGroup.DOFade 로 페이드. USS transition 으로 대체한다.
   =================================================================== */
.alliance-approve-panel {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    opacity: 0;
    display: none;
    transition-property: opacity;
    transition-duration: 0.25s;
}

/* 동맹 제안 바 (2026-09-19 시안) — 화면 절대좌표. 시안 1243x786 기준 S = 1.6497
   바 1399x139 @ (211,747). 반투명이라 뒤의 맵이 비친다 */
.alliance-approve__bar {
    position: absolute;
    left: 211px;
    top: 747px;
    width: 1399px;
    height: 139px;
    background-image: url("/Assets/Contents/Image/BG/InGame/bottom_bg2.png");
    -unity-background-scale-mode: stretch-to-fill;
    /* 시안의 반투명 바 색을 Linear 색공간에서 역산한 값이다.
       bottom_bg2(40,46,54) 를 검은 배경 위에서 (24,31,32) 로 보이게 맞춘 틴트 (2026-09-19) */
    -unity-background-image-tint-color: rgba(191, 204, 183, 0.83);
}

.alliance-approve__title {
    position: absolute;
    left: 188px;
    top: 0;
    bottom: 0;
    width: 220px;
    margin: 0;
    padding: 0;
    font-size: 43px;
    color: rgb(255, 255, 255);
    -unity-font-definition: url("/Assets/Contents/Font/GyeonggiTitle-Medium.ttf");
    -unity-font-style: normal;
    -unity-text-align: middle-left;
}

/* 제안한 플레이어 아이콘 묶음 : btn_bg7.png (9슬라이스 30), 내용만큼 늘어난다 */
.alliance-approve__icon-panel {
    position: absolute;
    left: 394.3px;
    top: 26.5px;
    height: 87px;
    flex-direction: row;
    align-items: center;
    padding-left: 26px;
    padding-right: 15.3px;
    background-image: url("/Assets/Contents/Image/Button/btn_bg7.png");
    -unity-slice-left: 30;
    -unity-slice-right: 30;
    -unity-slice-top: 30;
    -unity-slice-bottom: 30;
}

/* 보상 : N + 코인 */
.alliance-approve__reward-panel {
    position: absolute;
    left: 795.2px;
    top: 0;
    bottom: 0;
    flex-direction: row;
    align-items: center;
}

.alliance-approve__reward {
    margin: 0;
    padding: 0;
    font-size: 39px;
    color: rgb(255, 255, 255);
    -unity-font-definition: url("/Assets/Contents/Font/GyeonggiTitle-Medium.ttf");
    -unity-font-style: normal;
    -unity-text-align: middle-left;
}

.alliance-approve__coin {
    width: 48px;
    height: 48px;
    margin-left: 11.6px;
    flex-shrink: 0;
    background-image: url("/Assets/Contents/Image/BG/Main/Coin.png");
    -unity-background-scale-mode: scale-to-fit;
}

/* 철회 버튼 */
.alliance-approve__cancel-btn {
    position: absolute;
    left: 1026.2px;
    top: 26.5px;
    width: 186px;
    height: 87px;
    margin: 0;
    padding: 0;
    border-width: 0;
    border-radius: 16px;
    background-color: rgb(69, 73, 79);
    transition-property: scale;
    transition-duration: 0.08s;
}

.alliance-approve__cancel-btn:hover { scale: 1.03 1.03; }
.alliance-approve__cancel-btn:active { scale: 0.97 0.97; }
.alliance-approve__cancel-btn:disabled { opacity: 0.55; }

.alliance-approve__cancel-label {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    margin: 0;
    padding: 0;
    font-size: 38px;
    color: rgb(255, 255, 255);
    -unity-font-definition: url("/Assets/Contents/Font/GyeonggiTitle-Medium.ttf");
    -unity-font-style: normal;
    -unity-text-align: middle-center;
}

/* Icon_0~6 : 47.45x50.7 에 scale 1.5, 간격 34.6 */
.alliance-approve__icon {
    width: 36.3px;
    height: 38.8px;
    margin-right: 7.7px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

/* -------------------------------------------------------------------
   결과 상태 (.alliance-approve--result) — 제안이 성립/거절되면 바가
   "아이콘 + 요청 승인 N/M" 작은 알약으로 바뀐다 (2026-09-19 시안)
   시안 1680x538, 게임화면 709x399 -> S = 2.7091 (턴 종료 버튼 / 메시지 바로 보정)
   알약 501 x 79 @ top 814.9 — 폭은 플레이어 수에 따라 달라지므로 **바(211..1610) 중앙**에 붙인다
   (left:50% 는 바 기준이다. 실측 657.5 / 시안 633.1 — 24px 차이)
   ------------------------------------------------------------------- */
.alliance-approve--result {
    background-image: none;
}

.alliance-approve--result .alliance-approve__title,
.alliance-approve--result .alliance-approve__reward-panel,
.alliance-approve--result .alliance-approve__cancel-btn {
    display: none;
}

.alliance-approve--result .alliance-approve__icon-panel {
    left: 50%;
    top: 67.9px;
    height: 79px;
    translate: -50% 0;
    padding-left: 24px;
    padding-right: 27px;
}

/* 알약에서는 아이콘이 1.548 배 커진다 */
.alliance-approve--result .alliance-approve__icon {
    width: 56.2px;
    height: 60px;
    margin-right: 11.9px;
}

.alliance-approve--result .alliance-approve__on {
    left: 9.3px;
    top: 15.5px;
    width: 37.6px;
    height: 28.9px;
}

.alliance-approve--result .alliance-approve__off {
    left: 4.5px;
    top: 6.3px;
    width: 47.4px;
    height: 47.4px;
}

.alliance-approve__result-title {
    display: none;
    margin: 0;
    margin-left: 17.9px;
    padding: 0;
    flex-shrink: 0;
    font-size: 39px;
    color: rgb(255, 255, 255);
    -unity-font-definition: url("/Assets/Contents/Font/GyeonggiTitle-Medium.ttf");
    -unity-font-style: normal;
    -unity-text-align: middle-left;
}

.alliance-approve__count {
    display: none;
    margin: 0;
    margin-left: 32.5px;
    padding: 0;
    flex-shrink: 0;
    font-size: 36px;
    color: rgb(255, 255, 255);
    -unity-font-definition: url("/Assets/Contents/Font/GyeonggiTitle-Medium.ttf");
    -unity-font-style: normal;
    -unity-text-align: middle-left;
}

.alliance-approve--result .alliance-approve__result-title,
.alliance-approve--result .alliance-approve__count {
    display: flex;
}

.alliance-approve__icon--0 { background-image: url("/Assets/Contents/Image/BG/InGame/Icon_bg_0.png"); }
.alliance-approve__icon--1 { background-image: url("/Assets/Contents/Image/BG/InGame/Icon_bg_1.png"); }
.alliance-approve__icon--2 { background-image: url("/Assets/Contents/Image/BG/InGame/Icon_bg_2.png"); }
.alliance-approve__icon--3 { background-image: url("/Assets/Contents/Image/BG/InGame/Icon_bg_3.png"); }
.alliance-approve__icon--4 { background-image: url("/Assets/Contents/Image/BG/InGame/Icon_bg_4.png"); }
.alliance-approve__icon--5 { background-image: url("/Assets/Contents/Image/BG/InGame/Icon_bg_5.png"); }
.alliance-approve__icon--6 { background-image: url("/Assets/Contents/Image/BG/InGame/Icon_bg_6.png"); }

/* AprroveOn : CheckMark.png 31.8x24.4 (아이콘 중앙) */
.alliance-approve__on {
    position: absolute;
    left: 6px;
    top: 10px;
    width: 24.3px;
    height: 18.7px;
    background-image: url("/Assets/Contents/Image/BG/InGame/CheckMark.png");
    -unity-background-image-tint-color: rgb(174, 251, 138);
    -unity-background-scale-mode: scale-to-fit;
}

/* AprroveOff : close_btn.png 40x40 (아이콘 중앙) */
/* close_btn.png 은 원래 청록색이라 청록 플레이어 아이콘 위에서 안 보인다 —
   거절 표시는 빨강으로 틴트한다 (2026-09-19) */
.alliance-approve__off {
    position: absolute;
    left: 2.9px;
    top: 4.1px;
    width: 30.6px;
    height: 30.6px;
    background-image: url("/Assets/Contents/Image/Button/close_btn.png");
    -unity-background-image-tint-color: rgb(255, 69, 73);
    -unity-background-scale-mode: scale-to-fit;
}

/* -------------------------------------------------------------------
   동맹 제안 받기 바 (2026-09-19 시안). 제안자 쪽 바(.alliance-approve__bar)와
   같은 디자인이고 버튼만 거절 / 수락 두 개다.
   시안 1423x831 안의 게임 화면 1339x754 → S = 1.43585 (턴 종료 버튼 / 메시지 바로 보정)
   바 1433x139 @ (179,747) — 오른쪽 끝이 제안자 바와 같은 1612 다
   ------------------------------------------------------------------- */
/* 2026-09-26 : 복수 제안 시안(좌우 화살표)에 맞춰 바를 210 / 1400 으로. 내부 요소의 화면 좌표는 그대로라 -31 씩 옮겼다 */
.approve-alliance__bar {
    position: absolute;
    left: 210px;
    top: 747px;
    width: 1400px;
    height: 139px;
    display: none;
    background-image: url("/Assets/Contents/Image/BG/InGame/bottom_bg2.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: rgba(191, 204, 183, 0.83);
}

.approve-alliance__title {
    position: absolute;
    left: 89px;
    top: 0;
    bottom: 0;
    width: 220px;
    margin: 0;
    padding: 0;
    font-size: 43px;
    color: rgb(255, 255, 255);
    -unity-font-definition: url("/Assets/Contents/Font/GyeonggiTitle-Medium.ttf");
    -unity-font-style: normal;
    -unity-text-align: middle-left;
}

.approve-alliance__icon-panel {
    position: absolute;
    left: 294.6px;
    top: 26.5px;
    height: 87px;
    flex-direction: row;
    align-items: center;
    padding-left: 26px;
    padding-right: 15.3px;
    background-image: url("/Assets/Contents/Image/Button/btn_bg7.png");
    -unity-slice-left: 30;
