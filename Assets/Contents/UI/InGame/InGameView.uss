   원본 실측 : OnBtn(1833,846) 70x70 / Panel(105,915) 1430x175
   =================================================================== */
.area-editor {
    /* 2026-10-13 : 가로 가운데 1920 폭, 아래쪽 기준 (개발용 치트 패널) */
