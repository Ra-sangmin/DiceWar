}

.approve-alliance__refuse-btn,
.approve-alliance__accept-btn {
    position: absolute;
    top: 26.5px;
    height: 87px;
    margin: 0;
    padding: 0;
    border-width: 0;
    border-radius: 16px;
    transition-property: scale;
    transition-duration: 0.08s;
}

.approve-alliance__refuse-btn {
    left: 926.4px;
    width: 188px;
    background-color: rgb(69, 73, 79);
}

.approve-alliance__accept-btn {
    left: 1123.2px;
    width: 187px;
    background-color: rgb(255, 69, 73);
}

.approve-alliance__refuse-btn:hover,
.approve-alliance__accept-btn:hover { scale: 1.03 1.03; }

.approve-alliance__refuse-btn:active,
.approve-alliance__accept-btn:active { scale: 0.97 0.97; }

.approve-alliance__refuse-btn:disabled,
.approve-alliance__accept-btn:disabled { opacity: 0.45; }

.approve-alliance__btn-label {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    margin: 0;
    padding: 0;
    font-size: 38px;
    color: rgb(255, 255, 255);
    -unity-font-definition: url("/Assets/Contents/Font/GyeonggiTitle-Medium.ttf");
    -unity-font-style: normal;
    -unity-text-align: middle-center;
}

/* 이미 동맹 중이면 수락 대신 "배신 -N🪙" 이 된다 (2026-09-19 시안)
   .approve-alliance__accept-btn 보다 뒤에 와야 width 를 이긴다 */
.approve-alliance__betray-coin {
    display: none;
    flex-direction: row;
    align-items: center;
    margin-left: 18px;
}

.approve-alliance__betray-coin-text {
    margin: 0;
    padding: 0;
    flex-shrink: 0;
    font-size: 38px;
    color: rgb(255, 255, 255);
    -unity-font-definition: url("/Assets/Contents/Font/GyeonggiTitle-Medium.ttf");
    -unity-font-style: normal;
    -unity-text-align: middle-right;
}

.approve-alliance__betray-coin-icon {
    width: 35px;
    height: 35px;
    margin-left: 5px;
    flex-shrink: 0;
    background-image: url("/Assets/Contents/Image/BG/Main/Coin.png");
    -unity-background-scale-mode: scale-to-fit;
}

.approve-alliance__accept-btn--betray {
    width: 219px;
    flex-direction: row;
    justify-content: center;
    align-items: center;
}

/* 라벨을 레이아웃에 참여시켜야 배지와 묶여서 가운데로 온다 */
.approve-alliance__accept-btn--betray .approve-alliance__btn-label {
    position: relative;
    left: auto;
    right: auto;
    top: auto;
    bottom: auto;
    width: auto;
    height: auto;
}

.approve-alliance__accept-btn--betray .approve-alliance__betray-coin {
    display: flex;
}

