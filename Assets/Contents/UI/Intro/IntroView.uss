/* ===== 기본 폰트 ===== */
:root {
    -unity-font-definition: url("/Assets/Contents/Font/GyeonggiTitle-Medium.ttf");
    -unity-font-style: normal;
}

/* ===== Intro 화면 (2026-10-13 고급화 + 모든 화면 비율 대응) =====
   배경 / 로고 / 주사위 / 모서리 버튼은 ../Common/TitleView.uss (Main 과 공통).
   인트로는 로고를 조금 더 크게, 화면 위쪽 1/3 쯤에 둔다. 좌표는 1920x1080 스테이지 기준 */

.intro-logo {
    top: 230px;
    width: 1419px;
    height: 194px;
    margin-left: -709px;
}

.intro-rule {
    top: 470px;
}

/* 로그인 버튼 묶음 : 스테이지 아래쪽 */
.btn-panel {
    position: absolute;
    left: 0;
    right: 0;
    top: 600px;
    height: 330px;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 26px;
}

/* 로그인 버튼 : Main 의 싱글/멀티 플레이 버튼(.play-btn--primary)과 같은 모양 (2026-10-13)
   어두운 유리판 + 시안 테두리 + 위→아래 그라데이션, 글자는 밝은 시안 흰색 */
.signin-btn {
    width: 500px;
    height: 100px;
    margin: 0;
    padding: 0;
    border-width: 2px;
    border-radius: 18px;
    border-color: rgba(120, 225, 230, 0.7);
    background-color: rgba(10, 20, 34, 0.86);
    background-image: linear-gradient(to bottom, rgba(36, 74, 116, 0.95), rgba(12, 24, 40, 0.95));
    transition-property: scale, border-color;
    transition-duration: 0.12s;
}

.signin-btn:hover {
    scale: 1.03 1.03;
    border-color: rgba(139, 230, 234, 0.95);
}

.signin-btn:active {
    scale: 0.97 0.97;
}

.signin-btn__label {
    flex-grow: 1;
    margin: 0;
    padding: 0;
    font-size: 44px;
    letter-spacing: 3px;
    color: rgb(226, 248, 251);
    -unity-text-align: middle-center;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
}
