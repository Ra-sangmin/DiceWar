/* ===== 기본 폰트 (경기천년제목 Medium / normal) =====
   개별 규칙이 없는 요소가 Unity 기본 테마 폰트(NotInter)로 떨어지지 않도록 루트에 한 번 지정해 상속시킨다. */
:root {
    -unity-font-definition: url("/Assets/Contents/Font/GyeonggiTitle-Medium.ttf");
    -unity-font-style: normal;
}

/* ===== Loading 화면 (2026-10-13 고급화 + 모든 화면 비율 대응) =====
   배경 / 빛 / 비네트 / 주사위 / 로고 / 장식선은 ../Common/TitleView.uss (Intro, Main 과 공통).
   내용은 가운데 1920x1080 스테이지(.title-stage) 기준 좌표.
     로고(작게) → 장식선 → 상태 문구 → 플레이어 아이콘 카드 → 대기 시간(멀티만)
   요소 이름은 예전 그대로라 LoadingController 는 고치지 않았다. */

/* 로딩 화면은 주사위를 조금 흐리게 해서 가운데 내용에 눈이 가게 */
.loading-dice {
    opacity: 0.75;
}

/* 로고 : 원본 1577x216 의 0.6 배 */
.loading-logo {
    top: 170px;
    width: 946px;
    height: 130px;
    margin-left: -473px;
}

.loading-rule {
    top: 346px;
    width: 520px;
    margin-left: -260px;
}

/* ---------- 상태 문구 (Finding Players / Matching Completed / Loading) ---------- */
.loading-title {
    position: absolute;
    left: 50%;
    top: 392px;
    width: 1000px;
    height: 90px;
    margin: 0 0 0 -500px;
    padding: 0;
    font-size: 50px;
    letter-spacing: 4px;
    color: rgb(139, 230, 234);
    -unity-text-align: middle-center;
    text-shadow: 0 0 14px rgba(120, 225, 230, 0.45);
}

/* ---------- 플레이어 아이콘 줄 (로딩 인디케이터) — 2026-10-13 다시 디자인 ----------
   판(카드) 없이, 양끝이 사라지는 가는 시안 선 위에 작은 육각형 7개.
   꺼진 칸은 작고 흐리게, 켜진 칸(.player-icon--on)은 크고 밝게 + 뒤에 자기 색 원형 빛.
   C# 은 0.15초마다 다음 칸에 --on 을 옮긴다 → 빛이 왼쪽에서 오른쪽으로 흐르는 느낌 */
.player-icon-card {
    position: absolute;
    left: 50%;
    top: 548px;
    width: 640px;
    height: 72px;
    margin-left: -320px;
}

/* 아이콘 뒤를 지나가는 가는 선 */
.player-icon-track {
    position: absolute;
    left: 0;
    right: 0;
    top: 35px;
    height: 2px;
    background-image: linear-gradient(to right, rgba(120, 225, 230, 0), rgba(120, 225, 230, 0.35), rgba(120, 225, 230, 0));
}

.player-icon-panel {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    gap: 30px;
}

/* 칸 하나 40x40 */
.player-icon {
    width: 40px;
    height: 40px;
}

/* 육각형 */
.player-icon__bg {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    opacity: 0.35;
    scale: 0.74 0.74;
    -unity-background-scale-mode: scale-to-fit;
    transition-property: opacity, scale;
    transition-duration: 0.12s;
}

/* 켜진 칸 뒤의 빛 : 자기 색 원형 그라데이션 (예전 큰 빛 이미지 대신, 2026-10-13)
   UXML 에서 육각형(bg)보다 앞에 두어 뒤에 깔린다 */
.player-icon__fg {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 96px;
    height: 96px;
    translate: -50% -50%;
    opacity: 0;
    scale: 0.6 0.6;
    transition-property: opacity, scale;
    transition-duration: 0.12s;
}

.player-icon--on .player-icon__bg {
    opacity: 1;
    scale: 1.18 1.18;
}

.player-icon--on .player-icon__fg {
    opacity: 1;
    scale: 1 1;
}

.player-icon--0 .player-icon__fg { background-image: radial-gradient(circle at center, rgba(255, 70, 90, 0.55) 0%, rgba(255, 70, 90, 0) 70%); }
.player-icon--1 .player-icon__fg { background-image: radial-gradient(circle at center, rgba(255, 235, 90, 0.55) 0%, rgba(255, 235, 90, 0) 70%); }
.player-icon--2 .player-icon__fg { background-image: radial-gradient(circle at center, rgba(170, 235, 60, 0.55) 0%, rgba(170, 235, 60, 0) 70%); }
.player-icon--3 .player-icon__fg { background-image: radial-gradient(circle at center, rgba(110, 225, 240, 0.55) 0%, rgba(110, 225, 240, 0) 70%); }
.player-icon--4 .player-icon__fg { background-image: radial-gradient(circle at center, rgba(140, 125, 255, 0.55) 0%, rgba(140, 125, 255, 0) 70%); }
.player-icon--5 .player-icon__fg { background-image: radial-gradient(circle at center, rgba(255, 140, 200, 0.55) 0%, rgba(255, 140, 200, 0) 70%); }
.player-icon--6 .player-icon__fg { background-image: radial-gradient(circle at center, rgba(40, 210, 160, 0.55) 0%, rgba(40, 210, 160, 0) 70%); }

/* ---------- 대기 시간 (멀티플레이에서만 표시) ----------
   Main 의 코인 알약과 같은 모양 : 어두운 판 + 얇은 테두리, 아래에 작은 설명 글자 */
.time-panel {
    position: absolute;
    left: 50%;
    top: 670px;
    width: 280px;
    height: 92px;
    margin-left: -140px;
    border-width: 2px;
    border-radius: 46px;
    border-color: rgba(120, 225, 230, 0.55);
    background-color: rgba(8, 14, 24, 0.85);
}

.time-text {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    margin: 0;
    padding: 0;
    font-size: 46px;
    letter-spacing: 2px;
    color: rgb(226, 248, 251);
    -unity-text-align: middle-center;
}

.waiting-label {
    position: absolute;
    left: 50%;
    top: 104px;
    width: 600px;
    height: 50px;
    margin: 0 0 0 -300px;
    padding: 0;
    font-size: 30px;
    letter-spacing: 3px;
    color: rgb(150, 176, 196);
    -unity-text-align: middle-center;
}

/* 색 순서는 피그마 시안 기준 : 빨강 / 노랑 / 연두 / 청록 / 보라 / 분홍 / 초록 */
.player-icon--0 .player-icon__bg { background-image: url("/Assets/Contents/Image/hexagon/Old/player_hax_bg_0.png"); }
.player-icon--1 .player-icon__bg { background-image: url("/Assets/Contents/Image/hexagon/Old/player_hax_bg_1.png"); }
.player-icon--2 .player-icon__bg { background-image: url("/Assets/Contents/Image/hexagon/Old/player_hax_bg_2.png"); }
.player-icon--3 .player-icon__bg { background-image: url("/Assets/Contents/Image/hexagon/Old/player_hax_bg_4.png"); }
.player-icon--4 .player-icon__bg { background-image: url("/Assets/Contents/Image/hexagon/Old/player_hax_bg_6.png"); }
.player-icon--5 .player-icon__bg { background-image: url("/Assets/Contents/Image/hexagon/Old/player_hax_bg_5.png"); }
.player-icon--6 .player-icon__bg { background-image: url("/Assets/Contents/Image/hexagon/Old/player_hax_bg_3.png"); }
