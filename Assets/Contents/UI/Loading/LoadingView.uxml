<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" editor-extension-mode="False">
    <Style src="../Common/TitleView.uss" />
    <Style src="LoadingView.uss" />
    <ui:VisualElement name="loading-root" class="title-root loading-root">
        <ui:VisualElement name="loading-glow" class="title-glow" picking-mode="Ignore" />
        <ui:VisualElement name="loading-dice-left" class="title-dice title-dice--left loading-dice" picking-mode="Ignore" />
        <ui:VisualElement name="loading-dice-right" class="title-dice title-dice--right loading-dice" picking-mode="Ignore" />
        <ui:VisualElement name="loading-vignette" class="title-vignette" picking-mode="Ignore" />
        <ui:VisualElement name="loading-stage" class="title-stage" picking-mode="Ignore">
            <ui:VisualElement name="loading-logo" class="title-logo loading-logo" picking-mode="Ignore" />
            <ui:VisualElement name="loading-rule" class="title-rule loading-rule" picking-mode="Ignore">
                <ui:VisualElement class="title-rule__gem" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:Label name="loading-title" text="Loading.." class="loading-title" picking-mode="Ignore" />
            <ui:VisualElement name="player-icon-card" class="player-icon-card" picking-mode="Ignore">
                <ui:VisualElement name="player-icon-track" class="player-icon-track" picking-mode="Ignore" />
                <ui:VisualElement name="player-icon-panel" class="player-icon-panel" picking-mode="Ignore">
                <ui:VisualElement name="player-icon-0" class="player-icon player-icon--0" picking-mode="Ignore">
                    <ui:VisualElement class="player-icon__fg" picking-mode="Ignore" />
                    <ui:VisualElement class="player-icon__bg" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement name="player-icon-1" class="player-icon player-icon--1" picking-mode="Ignore">
                    <ui:VisualElement class="player-icon__fg" picking-mode="Ignore" />
                    <ui:VisualElement class="player-icon__bg" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement name="player-icon-2" class="player-icon player-icon--2" picking-mode="Ignore">
                    <ui:VisualElement class="player-icon__fg" picking-mode="Ignore" />
                    <ui:VisualElement class="player-icon__bg" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement name="player-icon-3" class="player-icon player-icon--3" picking-mode="Ignore">
                    <ui:VisualElement class="player-icon__fg" picking-mode="Ignore" />
                    <ui:VisualElement class="player-icon__bg" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement name="player-icon-4" class="player-icon player-icon--4" picking-mode="Ignore">
                    <ui:VisualElement class="player-icon__fg" picking-mode="Ignore" />
                    <ui:VisualElement class="player-icon__bg" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement name="player-icon-5" class="player-icon player-icon--5" picking-mode="Ignore">
                    <ui:VisualElement class="player-icon__fg" picking-mode="Ignore" />
                    <ui:VisualElement class="player-icon__bg" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement name="player-icon-6" class="player-icon player-icon--6" picking-mode="Ignore">
                    <ui:VisualElement class="player-icon__fg" picking-mode="Ignore" />
                    <ui:VisualElement class="player-icon__bg" picking-mode="Ignore" />
                </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="time-panel" class="time-panel" picking-mode="Ignore">
                <ui:Label name="time-text" text="00 : 00" class="time-text" picking-mode="Ignore" />
                <ui:Label name="waiting-label" text="waiting time" class="waiting-label" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
