/* ===== 기본 폰트 (경기천년제목 Medium / normal) =====
   개별 규칙이 없는 요소가 Unity 기본 테마 폰트(NotInter)로 떨어지지 않도록 루트에 한 번 지정해 상속시킨다. */
:root {
    -unity-font-definition: url("/Assets/Contents/Font/GyeonggiTitle-Medium.ttf");
    -unity-font-style: normal;
}

/* ===== Main 화면 (2026-10-13 고급화 + 모든 화면 비율 대응) =====
   배경 / 로고 / 주사위 / 모서리 버튼은 ../Common/TitleView.uss (Intro 와 공통).
   여기에는 플레이 버튼 / 코인 / 개발용 핫스팟만 둔다. 좌표는 1920x1080 스테이지 기준 */

/* ---------- 좌하단 숨김 개발용 핫스팟 (주사위 설정 팝업) — 원본도 alpha 0 인 투명 버튼 ---------- */
.dice-setting-btn {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 298px;
    height: 337px;
    margin: 0;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
}

/* ---------- 플레이 버튼 3종 ----------
   어두운 유리판 + 시안 테두리. 싱글 / 멀티는 주 버튼(조금 크고 밝게), 튜토리얼은 보조 버튼 */
.play-btn {
    position: absolute;
    left: 50%;
    width: 500px;
    height: 100px;
    margin: 0 0 0 -250px;
    padding: 0;
    border-width: 2px;
    border-radius: 18px;
    border-color: rgba(120, 225, 230, 0.45);
    background-color: rgba(10, 20, 34, 0.86);
    background-image: linear-gradient(to bottom, rgba(36, 74, 116, 0.95), rgba(12, 24, 40, 0.95));
    transition-property: scale, border-color;
    transition-duration: 0.12s;
}

.play-btn:hover {
    scale: 1.03 1.03;
    border-color: rgba(139, 230, 234, 0.95);
}

.play-btn:active {
    scale: 0.97 0.97;
}

.play-btn--primary {
    border-color: rgba(120, 225, 230, 0.7);
}

.play-btn__label {
    flex-grow: 1;
    margin: 0;
    padding: 0;
    font-size: 44px;
    letter-spacing: 3px;
    color: rgb(226, 248, 251);
    -unity-text-align: middle-center;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
}

.play-btn--single {
    top: 444px;
}

.play-btn--multi {
    top: 568px;
}

/* 보조 : 폭을 줄이고 더 투명하게 */
.play-btn--tutorial {
    top: 700px;
    width: 400px;
    height: 84px;
    margin-left: -200px;
    border-color: rgba(255, 255, 255, 0.18);
    background-image: none;
    background-color: rgba(10, 18, 30, 0.6);
}

.play-btn--tutorial .play-btn__label {
    font-size: 36px;
    color: rgb(170, 192, 210);
}

/* ---------- 코인 (금색 테두리의 알약) ---------- */
.coin-panel {
    position: absolute;
    left: 50%;
    top: 860px;
    width: 250px;
    height: 84px;
    margin-left: -125px;
}

.coin-bg {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    border-width: 2px;
    border-radius: 42px;
    border-color: rgba(255, 210, 110, 0.5);
    background-color: rgba(8, 14, 24, 0.82);
}

.coin-icon {
    position: absolute;
    left: 18px;
    top: 50%;
    width: 50px;
    height: 50px;
    margin-top: -25px;
    background-image: url("/Assets/Contents/Image/BG/Main/Coin.png");
    -unity-background-scale-mode: scale-to-fit;
}

/* 아이콘 오른쪽 남는 폭 가운데 (5자리까지) */
.coin-text {
    position: absolute;
    left: 74px;
    right: 14px;
    top: 0;
    bottom: 0;
    margin: 0;
    padding: 0;
    font-size: 42px;
    color: rgb(255, 236, 190);
    -unity-text-align: middle-center;
}
