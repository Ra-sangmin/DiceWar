<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" editor-extension-mode="False">
    <Style src="../Common/TitleView.uss" />
    <Style src="MainView.uss" />
    <ui:VisualElement name="main-root" class="title-root main-root">
        <ui:VisualElement name="main-glow" class="title-glow" picking-mode="Ignore" />
        <ui:VisualElement name="main-dice-left" class="title-dice title-dice--left" picking-mode="Ignore" />
        <ui:VisualElement name="main-dice-right" class="title-dice title-dice--right" picking-mode="Ignore" />
        <ui:VisualElement name="main-vignette" class="title-vignette" picking-mode="Ignore" />
        <ui:VisualElement name="main-stage" class="title-stage" picking-mode="Ignore">
            <ui:VisualElement name="main-logo" class="title-logo" picking-mode="Ignore" />
            <ui:VisualElement name="main-rule" class="title-rule" picking-mode="Ignore">
                <ui:VisualElement class="title-rule__gem" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:Button name="single-play-btn" text="" class="play-btn play-btn--single play-btn--primary">
                <ui:Label name="single-play-label" text="Single Player" class="play-btn__label" />
            </ui:Button>
            <ui:Button name="multi-play-btn" text="" class="play-btn play-btn--multi play-btn--primary">
                <ui:Label name="multi-play-label" text="Multi Players" class="play-btn__label" />
            </ui:Button>
            <ui:Button name="tutorial-btn" text="" class="play-btn play-btn--tutorial">
                <ui:Label name="tutorial-label" text="Tutorial" class="play-btn__label" />
            </ui:Button>
            <ui:VisualElement name="coin-panel" class="coin-panel">
                <ui:VisualElement name="coin-bg" class="coin-bg">
                    <ui:VisualElement name="coin-icon" class="coin-icon" picking-mode="Ignore" />
                    <ui:Label name="coin-text" text="0" class="coin-text" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Button name="info-btn" text="" class="corner-btn corner-btn--info" />
        <ui:Button name="setting-btn" text="" class="corner-btn corner-btn--setting" />
        <ui:Button name="dice-setting-btn" text="" class="dice-setting-btn" />
    </ui:VisualElement>
</ui:UXML>
