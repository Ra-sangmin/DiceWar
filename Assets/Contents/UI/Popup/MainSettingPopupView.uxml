<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" editor-extension-mode="False">
    <Style src="PopupView.uss" />
    <ui:VisualElement name="main-setting-root" class="popup-root popup-open-anim">
        <ui:VisualElement name="main-setting-mask" class="main-setting__mask" />
        <ui:VisualElement name="main-setting-plate" class="popup-plate main-setting__plate" picking-mode="Ignore" />
        <ui:VisualElement name="main-setting-panel" class="main-setting__bg">
            <ui:Label name="main-setting-title" text="" class="main-setting__title" picking-mode="Ignore" />
            <ui:VisualElement name="main-setting-sound-row" class="main-setting__row main-setting__row--sound">
                <ui:Label name="main-setting-sound-label" text="" class="main-setting__row-label" picking-mode="Ignore" />
                <ui:Button name="main-setting-sound-btn" text="" class="main-setting__sound-btn">
                    <ui:VisualElement name="main-setting-sound-check" class="main-setting__sound-check" picking-mode="Ignore" />
                </ui:Button>
            </ui:VisualElement>
            <ui:VisualElement name="main-setting-lang-row" class="main-setting__row main-setting__row--lang">
                <ui:Label name="main-setting-lang-label" text="" class="main-setting__row-label" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:Button name="main-setting-logout-btn" text="" class="main-setting__logout-btn">
                <ui:Label name="main-setting-logout-label" text="" class="main-setting__logout-label" picking-mode="Ignore" />
            </ui:Button>
            <ui:Button name="main-setting-close-btn" text="" class="main-setting__close-btn" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
