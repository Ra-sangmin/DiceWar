    -unity-font-style: normal;
    -unity-text-align: middle-center;
    white-space: normal;
}

.give-up__close-btn {
    position: absolute;
    left: 1491px;
    top: 227px;
    width: 100px;
    height: 101px;
    margin: 0;
    padding: 0;
