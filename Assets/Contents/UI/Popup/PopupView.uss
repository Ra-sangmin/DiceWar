/* ---------- 왼쪽 : 승리 보상 (세로 중심 x = 350) ---------- */
.option__reward-panel {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.option__reward-title {
    position: absolute;
    left: 671.5px;
    top: 379.3px;
    width: 420px;
    height: 100px;
    margin: 0;
    padding: 0;
    translate: -50% 0;
    font-size: 46px;
    color: rgb(255, 255, 255);
    -unity-font-definition: url("/Assets/Contents/Font/GyeonggiTitle-Medium.ttf");
    -unity-font-style: normal;
    -unity-text-align: middle-center;
}

/* 코인 3개를 겹쳐 쌓는다 (시안의 코인 더미) */
.option__reward-coins {
    position: absolute;
    left: 671.5px;
    top: 551.6px;
    width: 123px;
    height: 76px;
    translate: -50% 0;
}

.option__reward-coin {
    position: absolute;
    background-image: url("/Assets/Contents/Image/BG/Main/Coin.png");
    -unity-background-scale-mode: scale-to-fit;
}

.option__reward-coin--left   { left: 0;    top: 17px; width: 59px; height: 59px; }
.option__reward-coin--right  { left: 64px; top: 17px; width: 59px; height: 59px; }
.option__reward-coin--center { left: 26px; top: 0;    width: 71px; height: 71px; }

.option__reward-text {
    position: absolute;
    left: 671.5px;
    top: 706.7px;
    width: 420px;
    height: 100px;
    margin: 0;
    padding: 0;
    translate: -50% 0;
    font-size: 42px;
    color: rgb(255, 255, 255);
    -unity-font-definition: url("/Assets/Contents/Font/GyeonggiTitle-Medium.ttf");
    -unity-font-style: normal;
    -unity-text-align: middle-center;
}

/* ---------- 오른쪽 : 버튼 목록 ---------- */
.option__btn-panel {
    position: absolute;
    left: 993.2px;
    top: 369.8px;
    flex-direction: column;
    align-items: flex-start;
}

/* 공용 세로 버튼 (btn_bg.png Simple) */
.option__btn {
    width: 415px;
    height: 87px;
    margin: 0;
    padding: 0;
    flex-shrink: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    background-image: url("/Assets/Contents/Image/Button/btn_bg.png");
    -unity-background-scale-mode: stretch-to-fill;
    transition-property: scale;
    transition-duration: 0.08s;
}

.option__btn:hover { scale: 1.03 1.03; }
.option__btn:active { scale: 0.97 0.97; }

.option__btn-label {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    margin: 0;
    padding: 0;
    font-size: 38px;
    color: rgb(135, 233, 244);
    -unity-font-definition: url("/Assets/Contents/Font/GyeonggiTitle-Medium.ttf");
    -unity-font-style: normal;
    -unity-text-align: middle-center;
}

/* 계속하기 : btn_bg2 (Sliced 30) 빨강 + 흰 글자 */
.option__continue-btn {
    background-image: url("/Assets/Contents/Image/Button/btn_bg2.png");
    -unity-slice-left: 30;
    -unity-slice-right: 30;
    -unity-slice-top: 30;
    -unity-slice-bottom: 30;
}

.option__continue-label {
    color: rgb(255, 255, 255);
}

/* 새로하기 : 광고 버튼 위에 Play 버튼이 겹친다 */
.option__play-group {
    width: 415px;
    height: 87px;
    flex-shrink: 0;
}

.option__ad-btn {
    position: absolute;
    left: 3px;
    top: 3px;
    right: 3px;
    bottom: 3px;
    margin: 0;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    background-image: url("/Assets/Contents/Image/Button/btn_bg4.png");
