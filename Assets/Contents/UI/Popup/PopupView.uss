/* ===================================================================
   InfoPopup (TeamOfConditionsPopup / PrivatePolicyPopup) — 약관 본문
   원본 : Mask 검정 100% / ContensPanel(175,80) 1645x890 BG4
          Viewport 는 스크롤바 자리 17px 를 뺀 1628 폭
          Content 는 VLG(padding top 48 / bottom 50, spacing 42.5, 가운데 정렬)
   =================================================================== */
.info__mask {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgb(0, 0, 0);
}

.info__panel {
    position: absolute;
    left: 175px;
    top: 80px;
    width: 1645px;
    height: 890px;
}

.info__bg {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-image: url("/Assets/Contents/Image/BG/Main/BG4.png");
    -unity-background-scale-mode: stretch-to-fill;
}

.info__scroll {
    position: absolute;
    left: 0;
    top: 0;
    right: 17px;
    bottom: 0;
}

/* ---------- 약관 / 개인정보 세로 스크롤 바 (2026-09-29) ----------
   기본 Scroller 를 가늘고 둥근 막대로 : 위아래 화살표 버튼은 숨기고, 가는 선 트랙 + 시안 그라데이션 손잡이(빛 번짐).
   커서를 올리거나 잡으면 조금 밝아진다. 크기는 ScrollView 가 내용 길이에 맞춰 정한다. */
.info__scroll .unity-scroller--vertical {
    width: 8px;
    min-width: 8px;
    margin: 48px 26px 48px 0;
    padding: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.info__scroll .unity-scroller--vertical > .unity-scroller__low-button,
.info__scroll .unity-scroller--vertical > .unity-scroller__high-button {
    display: none;
}

.info__scroll .unity-scroller--vertical > .unity-scroller__slider {
    flex-grow: 1;
    width: 8px;
    min-width: 8px;
    margin: 0;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
}

.info__scroll .unity-scroller--vertical > .unity-scroller__slider .unity-base-slider__input,
.info__scroll .unity-scroller--vertical > .unity-scroller__slider .unity-base-slider__drag-container {
    margin: 0;
    padding: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.info__scroll .unity-scroller--vertical > .unity-scroller__slider .unity-base-slider__tracker {
    /* 트랙은 가운데 2px 가는 선, 손잡이만 8px */
    position: absolute;
    left: 3px;
    right: 3px;
    top: 4px;
    bottom: 4px;
    width: auto;
    margin: 0;
    border-width: 0;
    border-radius: 1px;
    background-color: rgba(255, 255, 255, 0.12);
}

.info__scroll .unity-scroller--vertical > .unity-scroller__slider .unity-base-slider__dragger {
    left: 0;
    width: 8px;
    min-height: 60px;
    margin: 0;
    border-width: 0;
    border-radius: 4px;
    background-color: rgb(100, 200, 220);
    background-image: linear-gradient(to bottom, rgb(160, 242, 246), rgb(62, 148, 204));
    filter: drop-shadow(0px 0px 8px rgba(120, 225, 230, 0.45));
    opacity: 0.85;
    transition-property: opacity;
    transition-duration: 0.15s;
}

.info__scroll .unity-scroller--vertical > .unity-scroller__slider .unity-base-slider__dragger:hover,
.info__scroll .unity-scroller--vertical > .unity-scroller__slider .unity-base-slider__dragger:active {
    opacity: 1;
}

.info__scroll .unity-scroller--vertical > .unity-scroller__slider .unity-base-slider__dragger-border {
    display: none;
}

.info__title {
    width: 799.47px;
    height: 100px;
    flex-shrink: 0;
    margin: 0 0 22px 0;
    padding: 0;
    font-size: 63px;
    color: rgb(255, 255, 255);
    -unity-font-definition: url("/Assets/Contents/Font/GyeonggiTitle-Medium.ttf");
    -unity-font-style: normal;
    -unity-text-align: middle-center;
}

/* 원본은 TextMeshProUGUI(WantedSans-SemiBold 36). UI Toolkit 은 .ttf 를 직접 문다.
   크기는 같은 문서를 뽑은 HTML(final_terms_ko.html) 의 본문 비율에 맞췄다 —
   HTML 은 본문 폭 712px 에 16px 이라 한 줄에 44.5em, 여기는 1245px 이므로 28px 이 같은 비율이다.
   (제목 Label 63px = 28 x 2.25 라 HTML 의 h1(2.25rem)과도 맞는다)
   제목/줄간격 비율은 Utils.ConvertMarkdownToRichText 가 % 태그로 넣는다. */
.info__contents {
    /* 블록 요소(.md-*)를 담는 세로 컨테이너. 글꼴·색은 자식이 상속 */
    width: 1180px;
    flex-shrink: 0;
    margin: 0;
    padding: 0;
    color: rgb(214, 223, 233);
    font-size: 27px;
    -unity-font-definition: url("/Assets/Contents/Font/GyeonggiTitle-Medium.ttf");
    -unity-font-style: normal;
}

/* ---------- 약관 / 개인정보 문서 (InfoDocumentBuilder, 2026-09-29) ---------- */
.md-title-rule {
    align-self: center;
    width: 160px;
    height: 3px;
    margin: 0 0 30px 0;
    border-radius: 2px;
    background-image: linear-gradient(to right, rgba(120, 225, 230, 0), rgb(120, 225, 230), rgba(120, 225, 230, 0));
}

.md-meta {
    flex-direction: row;
    justify-content: center;
    margin: 0 0 44px 0;
}

.md-meta__item {
    margin: 0 8px;
    padding: 8px 22px;
    border-radius: 22px;
    border-width: 1px;
    border-color: rgba(120, 225, 230, 0.3);
    background-color: rgba(6, 18, 28, 0.6);
    font-size: 21px;
    color: rgb(135, 158, 180);
    -unity-text-align: middle-center;
}

.md-section__head {
    flex-direction: row;
    align-items: center;
    margin: 58px 0 22px 0;
    padding: 0 0 16px 0;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.09);
}

.md-section__head--first {
    margin-top: 14px;
}

.md-section__num {
    min-width: 58px;
    margin: 0 18px 0 0;
    padding: 4px 0;
    border-radius: 8px;
    background-color: rgba(120, 225, 230, 0.12);
    font-size: 21px;
    color: rgb(139, 230, 234);
    letter-spacing: 2px;
    -unity-text-align: middle-center;
    -unity-font-definition: url("/Assets/Contents/Font/GyeonggiTitle-Bold.ttf");
}

.md-section__title {
    font-size: 36px;
    color: rgb(255, 255, 255);
    letter-spacing: 1px;
    -unity-font-definition: url("/Assets/Contents/Font/GyeonggiTitle-Bold.ttf");
}

.md-paragraph {
    margin: 0 0 22px 0;
    white-space: normal;
}

.md-paragraph--lead {
    padding-left: 22px;
    border-left-width: 3px;
    border-left-color: rgba(120, 225, 230, 0.45);
}

.md-list {
    margin: 2px 0 24px 0;
    padding: 20px 30px;
    border-radius: 14px;
    border-width: 1px;
    /* 선형 색공간이라 흰색 저알파가 생각보다 밝게 보인다 → 어두운 남색 판 + 옅은 시안 테두리 */
    border-color: rgba(120, 225, 230, 0.14);
    background-color: rgba(6, 14, 24, 0.55);
}

.md-list__item {
    flex-direction: row;
    align-items: flex-start;
}

.md-list__dot {
    flex-shrink: 0;
    width: 8px;
    height: 8px;
    margin: 18px 18px 0 0;
    border-radius: 4px;
    background-color: rgb(120, 225, 230);
}

.md-list__text {
    flex-grow: 1;
    flex-shrink: 1;
    white-space: normal;
}

.md-contact {
    flex-direction: row;
    align-items: center;
    margin: 4px 0 10px 0;
    padding: 26px 32px;
    border-radius: 16px;
    border-width: 1px;
    border-color: rgba(120, 225, 230, 0.4);
    background-color: rgba(6, 18, 28, 0.6);
}

.md-contact__icon {
    flex-shrink: 0;
    width: 10px;
    height: 44px;
    margin-right: 24px;
    border-radius: 5px;
    background-image: linear-gradient(to bottom, rgb(160, 242, 246), rgb(62, 148, 204));
}

.md-contact__text {
    flex-grow: 1;
    flex-shrink: 1;
    white-space: normal;
}

.md-end-rule {
    align-self: center;
    width: 60px;
    height: 3px;
    margin: 56px 0 0 0;
    border-radius: 2px;
    background-color: rgba(120, 225, 230, 0.35);
}

.info__back-btn {
    position: absolute;
    left: -155px;
    top: 0;
    width: 138px;
    height: 138px;
    margin: 0;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    background-image: url("/Assets/Contents/Image/Button/back_btn.png");
    -unity-background-scale-mode: scale-to-fit;
    transition-property: scale;
    transition-duration: 0.08s;
}

.info__back-btn:hover { scale: 1.05 1.05; }
.info__back-btn:active { scale: 0.95 0.95; }

/* ===================================================================
   DiceSetPopup — 개발용 주사위 개수 조정 패널
   Main 씬 좌하단 투명 핫스팟(dice-setting-btn)으로만 열린다.
   원본 : Mask 검정 86.3% / ContensPanel(321.5,33) 1277x1010 popupBG
   아래 좌표는 ContensPanel 기준
   =================================================================== */
.dice-set__mask {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    /* URP backdrop-filter (2026-09-29) : 뒤 화면 흐림 + 예전보다 옅게 */
    backdrop-filter: blur(10px);
    background-color: rgba(0, 0, 0, 0.65);
}

/* 6.7 (2026-09-29) : popupBG.png 대신 뒤의 .dice-set__plate 가 판을 그린다.
   이 요소는 자식 배치 기준(예전 이미지 크기)만 유지하는 투명 컨테이너 */
.dice-set__bg {
    position: absolute;
    left: 321.5px;
    top: 33px;
    width: 1277px;
    height: 1010px;
}

/* 판 + 빛 번짐. 자식이 없는 별도 요소라 drop-shadow 가 글자를 흐리게 하지 않는다 */
.dice-set__plate {
    left: 381.5px;
    top: 97.2px;
    width: 1157px;
    height: 876.2px;
    border-radius: 18px;
}

.dice-set__title {
    position: absolute;
    left: 424.7px;
    top: 103px;
    width: 427.5px;
    height: 100px;
    margin: 0;
    padding: 0;
    font-size: 63px;
    color: rgb(255, 255, 255);
    -unity-font-definition: url("/Assets/Contents/Font/GyeonggiTitle-Medium.ttf");
    -unity-font-style: normal;
    -unity-text-align: middle-center;
}

/* 한 줄(난이도 하나). top 은 스크립트가 넣는다 */
.dice-set__row {
    position: absolute;
    left: 0;
    width: 1277px;
    height: 117.5px;
}

.dice-set__row-label {
    position: absolute;
    top: 0;
    width: 427.5px;
    height: 100px;
    margin: 0;
    padding: 0;
    font-size: 63px;
    color: rgb(255, 255, 255);
    -unity-font-definition: url("/Assets/Contents/Font/GyeonggiTitle-Medium.ttf");
    -unity-font-style: normal;
    -unity-text-align: middle-left;
}

.dice-set__row-label--title { left: 161.7px; }
.dice-set__row-label--min { left: 503.7px; }
.dice-set__row-label--max { left: 821.7px; }

/* 원본은 uGUI InputField(IntegerNumber). 배경 스프라이트(InputFieldBackground)는
   유니티 내장 리소스라 USS url() 로 못 물어서 같은 색의 단색으로 대체했다. */
.dice-set__input {
    position: absolute;
    top: 17px;
    width: 100px;
    height: 70px;
    margin: 0;
    padding: 0;
    /* font-size 는 상속되므로 여기서 한 번만 준다 (안쪽 TextElement 까지 내려간다) */
    font-size: 40px;
    color: rgb(50, 50, 50);
    -unity-font-definition: url("/Assets/Contents/Font/GyeonggiTitle-Medium.ttf");
    -unity-font-style: normal;
}

.dice-set__input--min { left: 644.2px; }
.dice-set__input--max { left: 980.5px; }

.dice-set__input .unity-text-field__input {
    margin: 0;
    padding: 0;
    background-color: rgb(161, 161, 161);
    border-width: 0;
    /* URP(6.7b2)에서 overflow:hidden + border-radius 조합(스텐실 마스크)이 흰 사각형으로 그려지는 문제 → 모서리 0 (2026-09-29) */
    border-radius: 0;
    -unity-text-align: middle-center;
}

.dice-set__line {
    position: absolute;
    left: 137px;
    top: 112.5px;
    width: 985px;
    height: 5px;
    background-color: rgb(69, 73, 79);
}

.dice-set__close-btn {
    position: absolute;
    left: 1057.1px;
    top: 102px;
    width: 100px;
    height: 101px;
    margin: 0;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    background-image: url("/Assets/Contents/Image/Button/close_btn.png");
    -unity-background-scale-mode: scale-to-fit;
    transition-property: scale;
    transition-duration: 0.08s;
}

.dice-set__close-btn:hover { scale: 1.05 1.05; }
.dice-set__close-btn:active { scale: 0.95 0.95; }

/* ===================================================================
   GameResultPopup — 싱글 전용 (.game-result--single 를 root 에 붙인다)
   시안 (승리/패배 2종), 보이는 판 312x207 -> 화면 945.1 x 627.0
   배율 S = 3.0292 (시안 버튼 폭 137 -> 415. 다른 팝업과 버튼 크기를 맞춘 값)
   요소: 1044 x 723.7 @ left 438.4, top 176.6   (화면 중앙 960,540)
   보이는 판: 945.1 x 627.0 @ (487.45, 226.5)
   화면 x = 487.45 + 시안x * 3.0292
   화면 y = 226.5  + 시안y * 3.0292

   보상/버튼은 OptionPopup 의 .option__* 클래스를 그대로 재사용하고
   여기서는 위치만 덮어쓴다.
   =================================================================== */

/* 싱글에서만 보이는 요소들 (기본 숨김) */
.game-result__single-only,
.game-result__retry-reward {
    display: none;
}

.game-result--single .game-result__single-only {
    display: flex;
}

/* 멀티/구버전 싱글 레이아웃은 싱글 시안에서 전부 숨긴다 */
.game-result--single .game-result__coin-image,
.game-result--single .game-result__coin-text,
.game-result--single .popup-btn--main,
.game-result--single .game-result__play-group {
    display: none;
}

.game-result--single .game-result__bg {
    /* 6.7 : popupBG_glow.png 대신 USS 로 그린다 (2026-09-29). 이미지의 투명 여백을 뺀 '보이는 판' 크기 */
    left: 487.5px;
    top: 222.6px;
    width: 945.9px;
    height: 627.8px;
    -unity-slice-left: 0;
    -unity-slice-right: 0;
    -unity-slice-top: 0;
    -unity-slice-bottom: 0;
    border-radius: 18px;
    border-width: 2px;
    border-color: rgb(69, 73, 79);
    background-color: rgb(19, 23, 29);
    background-image: radial-gradient(ellipse at center, rgb(28, 61, 108) 0%, rgb(19, 23, 29) 66%);
    filter: drop-shadow(0px 0px 20px rgba(120, 225, 230, 0.15));
}

.game-result--single .game-result__title {
    left: 50%;
    top: 281px;
    width: 800px;
    height: 100px;
    translate: -50% 0;
    font-size: 60px;
    color: rgb(255, 255, 255);
    -unity-font-definition: url("/Assets/Contents/Font/GyeonggiTitle-Medium.ttf");
    -unity-font-style: normal;
    -unity-text-align: middle-center;
}

.game-result--single .option__close-btn {
    left: 1279.6px;
    top: 280.5px;
}

/* ---------- 왼쪽 : 보상 ---------- */
.game-result__single-reward {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.game-result--single .game-result__single-reward-title {
    left: 723px;
    top: 427.9px;
}

/* .option__reward-coins 가 translate:-50% 0 을 갖고 있으므로 left 는 '중심 x' 다 */
.game-result--single .game-result__single-coins {
    left: 723px;
    top: 550.6px;
    width: 182px;
    height: 115px;
}

.game-result--single .game-result__single-coin--left   { left: 0;    top: 26px; width: 87px;  height: 87px; }
.game-result--single .game-result__single-coin--right  { left: 95px; top: 26px; width: 87px;  height: 87px; }
.game-result--single .game-result__single-coin--center { left: 39px; top: 0;    width: 105px; height: 105px; }

/* 패배(보상 0) 일 때 금화 더미 대신 회색 코인 한 장.
   coin_image.png 은 261x261 중 실제 동전이 99x99(중심 130,126) 뿐이라
   시안의 동전 지름 94px 에 맞추려면 요소를 248 로 키워야 한다 */
.game-result__single-lose-coin {
    position: absolute;
    left: 599.5px;
    top: 470.3px;
    width: 248px;
    height: 248px;
    display: none;
    background-image: url("/Assets/Contents/Image/BG/Main/coin_image.png");
    -unity-background-scale-mode: scale-to-fit;
}

.game-result--single .game-result__single-reward-text {
    left: 723px;
    top: 696px;
}

/* ---------- 오른쪽 : 버튼 3개 ---------- */
.game-result--single .game-result__single-btn-panel {
    left: 941.8px;
    top: 465.8px;
}

/* .option__btn { margin: 0 } 이 파일 앞쪽에 있으므로 자식 선택자로 특이도를 올린다 */
.game-result__single-btn-panel > .game-result__single-gap { margin-top: 13px; }
.game-result__single-btn-panel > .game-result__single-gap--wide { margin-top: 16px; }

/* ---------- 패배 전용 : 다시하기 보상 안내 ---------- */
.game-result--single .game-result__retry-reward {
    position: absolute;
    left: 756.8px;
    top: 763px;
    width: 600px;
    height: 60px;
    margin: 0;
    padding: 0;
    font-size: 30px;
    color: rgb(194, 198, 204);
    -unity-font-definition: url("/Assets/Contents/Font/GyeonggiTitle-Medium.ttf");
    -unity-font-style: normal;
    -unity-text-align: middle-right;
}
