    -unity-background-scale-mode: scale-to-fit;
}

/* -------------------------------------------------------------------
   OptionPopup - 멀티 전용 (.option--multi 를 option-root 에 붙인다)
   시안: 653x365, 보이는 패널 631x352 @(9,3) -> 화면 1350x753 @(285,165.9)
   scale S = 2.1392 (버튼 크기를 싱글과 동일하게 유지하도록 맞춘 값)
   좌표는 전부 popup-root(전체 화면) 기준이다. 패널 기준 값이 아니다!
   ------------------------------------------------------------------- */
.option__reward-rows {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    display: none;
}

.option--multi .option__reward-rows {
    display: flex;
}

.option--multi .option__bg {
    left: 225px;
    width: 1470px;
}

.option--multi .option__close-btn {
    left: 1477.9px;
    top: 220.7px;
}

.option--multi .option__btn-panel {
    left: 1157.8px;
    top: 407.6px;
}

/* 예상 보상 제목 - 멀티에서는 왼쪽 정렬 */
.option--multi .option__reward-title {
    left: 383.4px;
    top: 449.5px;
    width: 400px;
    translate: 0 0;
    -unity-text-align: middle-left;
}

/* 코인 더미 + 합계는 오른쪽 열로 이동 */
.option--multi .option__reward-coins {
    left: 943.9px;
    top: 473.9px;
    width: 150px;
    height: 92px;
}

.option--multi .option__reward-coin--left   { left: 0;    top: 21px; width: 72px; height: 72px; }
.option--multi .option__reward-coin--right  { left: 78px; top: 21px; width: 72px; height: 72px; }
.option--multi .option__reward-coin--center { left: 32px; top: 0;    width: 87px; height: 87px; }

.option--multi .option__reward-text {
    left: 940.7px;
    top: 625.9px;
}

/* 보상 내역 줄 - 라벨은 왼쪽, 값은 오른쪽(x 764.2) 끝에 맞춘다 */
.option__reward-row {
    position: absolute;
    left: 383.4px;
    width: 380.8px;
    height: 60px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.option__reward-row--1 { top: 542.3px; }
.option__reward-row--2 { top: 596.8px; }
.option__reward-row--3 { top: 651.3px; }
.option__reward-row--4 { top: 792.6px; }

.option__reward-label {
    font-size: 32px;
    color: rgb(135, 233, 244);
    -unity-font-definition: url("/Assets/Contents/Font/GyeonggiTitle-Medium.ttf");
    -unity-font-style: normal;
    -unity-text-align: middle-left;
    margin: 0;
    padding: 0;
}

.option__reward-value {
    font-size: 32px;
    color: rgb(244, 248, 252);
    -unity-font-definition: url("/Assets/Contents/Font/GyeonggiTitle-Medium.ttf");
    -unity-font-style: normal;
    -unity-text-align: middle-right;
    margin: 0;
    padding: 0;
}

.option__reward-row--3 .option__reward-value {
    color: rgb(255, 69, 73);
}

.option__reward-row--4 .option__reward-label,
.option__reward-row--4 .option__reward-value {
    color: rgb(169, 173, 179);
}
/* ===================================================================
   PlayerToggleIcon (원본 프리팹 120x120) + CoinBox
