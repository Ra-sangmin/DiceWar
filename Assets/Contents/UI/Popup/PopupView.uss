/* ===================================================================
   GameResultPopup - 멀티 전용 (.game-result--multi 를 root 에 붙인다)
   시안 (승리/패배 3종), 보이는 판 417x279 -> 화면 1067x714
   배율 S = 2.5588 (시안 버튼 높이 34 -> 87. 다른 팝업과 버튼 높이를 맞춘 값)
   요소: 1179 x 824 @ left 371, top 128   (화면 중앙 960,540)
   보이는 판: 1067.3 x 714 @ (426.4, 184.9)
   화면 x = 426.4 + (시안x - 21) * 2.5588
   화면 y = 184.9 + (시안y - 34) * 2.5588
   =================================================================== */
.game-result__reward-panel {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    display: none;
}

.game-result--multi .game-result__reward-panel {
    display: flex;
}

.game-result--multi .game-result__bg {
    /* 6.7 : popupBG_glow.png 대신 USS 로 그린다 (2026-09-29). 이미지의 투명 여백을 뺀 '보이는 판' 크기 */
    left: 426.4px;
    top: 180.3px;
    width: 1068.2px;
    height: 714.8px;
    -unity-slice-left: 0;
    -unity-slice-right: 0;
    -unity-slice-top: 0;
    -unity-slice-bottom: 0;
    border-radius: 18px;
    border-width: 2px;
    border-color: rgb(69, 73, 79);
    background-color: rgb(19, 23, 29);
    background-image: radial-gradient(ellipse at center, rgb(28, 61, 108) 0%, rgb(19, 23, 29) 66%);
    filter: drop-shadow(0px 0px 20px rgba(120, 225, 230, 0.15));
}

.game-result--multi .game-result__title {
    left: 50%;
    top: 243.7px;
    width: 800px;
    height: 100px;
    translate: -50% 0;
    font-size: 58px;
    -unity-font-definition: url("/Assets/Contents/Font/GyeonggiTitle-Medium.ttf");
    -unity-font-style: normal;
}

/* 싱글용 코인 이미지 / "N coin" 은 멀티에서 안 쓴다 */
.game-result--multi .game-result__coin-image,
.game-result--multi .game-result__coin-text {
    display: none;
}

.game-result__reward-title {
    position: absolute;
    left: 623px;
    top: 380.5px;
    width: 400px;
    height: 100px;
    margin: 0;
    padding: 0;
    font-size: 40px;
    color: rgb(255, 255, 255);
    -unity-font-definition: url("/Assets/Contents/Font/GyeonggiTitle-Medium.ttf");
    -unity-font-style: normal;
    -unity-text-align: middle-left;
}

/* 금화 더미(이득) / 회색 코인(손해) 은 둘 중 하나만 보인다 */
.game-result__reward-coins {
    position: absolute;
    left: 1109.7px;
    top: 420.3px;
    width: 150px;
    height: 92px;
}

.game-result__reward-coin--left   { left: 0;    top: 21px; width: 72px; height: 72px; }
.game-result__reward-coin--right  { left: 78px; top: 21px; width: 72px; height: 72px; }
.game-result__reward-coin--center { left: 32px; top: 0;    width: 87px; height: 87px; }

/* coin_image.png 은 261x261 중 실제 동전이 99x99(중심 130,126) 뿐이다.
   시안의 동전 지름 95px 에 맞추려면 요소를 250 으로 키워야 한다 */
