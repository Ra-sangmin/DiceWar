/* ===================================================================
   GiveUpPopup — 멀티 '동맹을 배신 하시겠습니까?' (2026-09-19 Figma 시안)
   시안 683x366, 보이는 판 645x345 @(13,4) -> 화면 1379.8x738 @(269.6,172.8)
   배율 S = 2.1392 (OptionPopup 멀티와 동일 — 버튼을 415x87 로 맞추는 값)
   화면 x = 269.6 + (시안x - 13) * 2.1392
   화면 y = 172.8 + (시안y -  4) * 2.1392
   버튼/가격 배지는 OptionPopup 의 .option__btn / .option__play-* / .option__need-coin-*
   클래스를 그대로 재사용한다 (위치가 없는 규칙들이라 공유 가능).
   =================================================================== */
.give-up__bg {
    position: absolute;
    /* 6.7 : popupBG_glow.png 대신 USS 로 그린다 (2026-09-29). 이미지의 투명 여백을 뺀 '보이는 판' 크기 */
    left: 269.6px;
    top: 168.1px;
    width: 1380.8px;
    height: 739.1px;
    border-radius: 18px;
    border-width: 2px;
    border-color: rgb(69, 73, 79);
    background-color: rgb(19, 23, 29);
    background-image: radial-gradient(ellipse at center, rgb(28, 61, 108) 0%, rgb(19, 23, 29) 66%);
    filter: drop-shadow(0px 0px 20px rgba(120, 225, 230, 0.15));
}

.give-up__title {
    position: absolute;
    left: 50%;
    top: 221px;
    width: 1000px;
    height: 100px;
    translate: -50% 0;
    margin: 0;
    padding: 0;
    font-size: 46px;
    color: rgb(255, 255, 255);
    -unity-font-definition: url("/Assets/Contents/Font/GyeonggiTitle-Medium.ttf");
    -unity-font-style: normal;
    -unity-text-align: middle-center;
}

.give-up__sub-title {
    position: absolute;
    left: 50%;
    top: 299.3px;
    width: 1000px;
    height: 100px;
