/* ===================================================================
   SMToggle (설정 토글) — popup_toggle_bg.png, 색은 스크립트가 지정
   =================================================================== */
.sm-toggle {
    position: absolute;
    top: 10px;
    height: 80px;
    margin: 0;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    background-image: url("/Assets/Contents/Image/Button/popup_toggle_bg.png");
    -unity-slice-left: 20;
    -unity-slice-right: 20;
    -unity-slice-top: 20;
    -unity-slice-bottom: 20;
    transition-property: scale;
    transition-duration: 0.08s;
}

.sm-toggle:hover { scale: 1.03 1.03; }
.sm-toggle:active { scale: 0.97 0.97; }

.sm-toggle__label {
    position: absolute;
    left: 50%;
    top: -10.1px;
    translate: -50% 0;
    width: 350px;
    height: 100px;
    margin: 0;
    padding: 0;
    font-size: 42px;
    -unity-font-definition: url("/Assets/Contents/Font/GyeonggiTitle-Medium.ttf");
    -unity-font-style: normal;
    -unity-text-align: middle-center;
}

/* 플레이어 수 토글은 top 이 2px 더 아래 */
.sm-toggle--count { top: 12px; }

/* 글자 길이에 맞춰 폭이 정해지는 토글 (PlaySetPopup).
   좌우 여백 33.5px + 버튼 사이 12px 는 Figma 시안 실측값.
   .sm-toggle--count 뒤에 와야 top 을 이긴다. */
.sm-toggle--auto {
    position: relative;
    left: auto;
    top: 0;
    width: auto;
    height: 80px;
    flex-shrink: 0;
