    -unity-slice-right: 15;
    -unity-slice-top: 15;
    -unity-slice-bottom: 15;
    transition-property: scale;
    transition-duration: 0.08s;
}

.option__ad-btn:hover { scale: 1.03 1.03; }
.option__ad-btn:active { scale: 0.97 0.97; }
.option__ad-btn:disabled { -unity-background-image-tint-color: rgba(200, 200, 200, 0.502); opacity: 0.8; }

.option__ad-icon {
    position: absolute;
