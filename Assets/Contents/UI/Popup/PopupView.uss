/* 라벨은 다른 버튼과 똑같이 버튼 한가운데. 가격은 오른쪽에 따로 붙는다 (시안) */
.option__play-label {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    margin: 0;
    padding: 0;
    font-size: 38px;
