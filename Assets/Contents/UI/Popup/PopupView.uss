/* ===== 기본 폰트 (경기천년제목 Medium / normal, 2026-09-26 변경) =====
   개별 규칙이 없는 요소가 Unity 기본 테마 폰트(NotInter)로 떨어지지 않도록
   루트에 한 번 지정해 상속시킨다. (2026-09-19) */
:root {
    -unity-font-definition: url("/Assets/Contents/Font/GyeonggiTitle-Medium.ttf");
    -unity-font-style: normal;
}

/* ===== 팝업 공통 스타일 (Resources 팝업 프리팹들이 함께 쓴다) =====
   좌표/크기는 기존 프리팹의 실측값을 그대로 옮긴 것이다.
   팝업은 UIPopupPanelSettings(SortingOrder 100) 를 쓰는 별도 패널이라
   인게임 HUD 패널(-10) 과 uGUI Overlay 캔버스(0) 보다 위에 그려진다. */

.popup-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* 팝업 내용 스테이지 : 기준 해상도(1920x1080) 좌표로 배치된 내용을 화면 가운데에 둔다.
   PanelSettings 가 높이 기준(Match 1)이라 화면이 16:9 보다 넓으면 폭이 1920 보다 커지는데,
   내용이 left 기준 px 좌표로 놓여 있어 왼쪽으로 치우쳐 보였다.
   막(mask / dim)은 화면 전체를 덮어야 하므로 스테이지 밖(루트 바로 아래)에 둔다.
   클릭은 막으로 통과하도록 UXML 에서 picking-mode="Ignore" 로 둔다. */
.popup-stage {
    position: absolute;
    left: 50%;
    top: 0;
    width: 1920px;
    height: 1080px;
    margin-left: -960px;
}

/* 6.7 키프레임 애니메이션 (2026-09-29) : 팝업이 뜰 때.
   예전에는 팝업 전체를 투명→불투명으로 페이드해서, 반투명한 동안 판 뒤로 메인 화면 버튼 등이 비쳐 잔상처럼 보였다.
   → 뒤 막(dim/mask)만 0.12초 페이드(PopupDimIn.asset), 판·내용은 처음부터 불투명하게 24px 아래에서 0.2초 떠오른다(PopupPanelIn.asset).
   곡선은 Assets/Contents/UI/Animation/ 의 UI Animation Clip — Animation 창에서 열어 고칠 수 있다.
   첫 프레임 깜빡임 방지 : 애니메이션은 처음 그려진 다음 프레임부터 재생되므로 막은 기본 opacity 0 으로 두고,
   재생 도중 PanelUI 가 --shown 을 붙여 1 로 남긴다. (막 규칙은 --ready 규칙보다 뒤에 있어야 한다 — 같은 우선순위) */
.popup-open-anim > * {
    /* translate 는 여기서 지정하지 않는다 : 가운데 정렬에 translate: -50% 를 쓰는 요소(.option__title 등)가 있어서
       덮어쓰면 위치가 틀어진다. 키프레임은 Translate.y 만 움직이므로 x 는 각 요소 값이 유지된다 */
    opacity: 0;
    -unity-animation-clip: url("/Assets/Contents/UI/Animation/PopupPanelIn.asset");
    animation-duration: 0.2s;
}

/* 글자(현지화)는 UI 가 준비된 뒤(OnUIReady)에 채워지므로 그 전 프레임에는 빈 판이 보인다 →
   판·내용은 PanelUI 가 준비 직후 --ready 를 붙일 때 한 번에(반투명 없이) 나타난다 */
.popup-open-anim.popup-open-anim--ready > * {
    opacity: 1;
}

.popup-open-anim > .popup-dim,
.popup-open-anim > .trade-popup__mask,
.popup-open-anim > .buy-coin__mask,
.popup-open-anim > .dice-set__mask,
.popup-open-anim > .info__mask,
.popup-open-anim > .main-info__mask,
.popup-open-anim > .main-setting__mask,
.popup-open-anim > .ok-popup__mask,
.popup-open-anim > .play-set__mask,
.popup-open-anim > .tutorial__mask {
    opacity: 0;
    -unity-animation-clip: url("/Assets/Contents/UI/Animation/PopupDimIn.asset");
    animation-duration: 0.12s;
}

.popup-open-anim.popup-open-anim--shown > .popup-dim,
.popup-open-anim.popup-open-anim--shown > .trade-popup__mask,
.popup-open-anim.popup-open-anim--shown > .buy-coin__mask,
.popup-open-anim.popup-open-anim--shown > .dice-set__mask,
.popup-open-anim.popup-open-anim--shown > .info__mask,
.popup-open-anim.popup-open-anim--shown > .main-info__mask,
.popup-open-anim.popup-open-anim--shown > .main-setting__mask,
.popup-open-anim.popup-open-anim--shown > .ok-popup__mask,
.popup-open-anim.popup-open-anim--shown > .play-set__mask,
.popup-open-anim.popup-open-anim--shown > .tutorial__mask {
    opacity: 1;
}

/* ---------- 플레이어 아이콘 이미지 (Icon_bg_0~6) ---------- */
.popup-player-icon--0 { background-image: url("/Assets/Contents/Image/BG/InGame/Icon_bg_0.png"); }
.popup-player-icon--1 { background-image: url("/Assets/Contents/Image/BG/InGame/Icon_bg_1.png"); }
.popup-player-icon--2 { background-image: url("/Assets/Contents/Image/BG/InGame/Icon_bg_2.png"); }
.popup-player-icon--3 { background-image: url("/Assets/Contents/Image/BG/InGame/Icon_bg_3.png"); }
.popup-player-icon--4 { background-image: url("/Assets/Contents/Image/BG/InGame/Icon_bg_4.png"); }
.popup-player-icon--5 { background-image: url("/Assets/Contents/Image/BG/InGame/Icon_bg_5.png"); }
.popup-player-icon--6 { background-image: url("/Assets/Contents/Image/BG/InGame/Icon_bg_6.png"); }

/* ===================================================================
   토스트 (YourTurnPopup / TimeOverPopup / InGameWarningPopup)
   원본 : 화면 상단 중앙 pivot(0.5,1) ap(-8.3,-190) 679x161, snack_bar.png
   =================================================================== */
.toast-popup {
    position: absolute;
    left: 50%;
    top: 190px;
    translate: -50% 0;
    margin-left: -8.3px;
    width: 679px;
    height: 161px;
    opacity: 0;
    background-image: url("/Assets/Contents/Image/BG/InGame/snack_bar.png");
    -unity-background-scale-mode: stretch-to-fill;
    transition-property: opacity;
    transition-duration: 0s;
    /* 6.7 키프레임 (2026-09-29) : 위에서 살짝 떨어지며 튕기듯 등장. 투명도는 기존대로 코드(트랜지션)가 맡는다.
       곡선은 Assets/Contents/UI/Animation/ToastIn.asset */
    -unity-animation-clip: url("/Assets/Contents/UI/Animation/ToastIn.asset");
    animation-duration: 0.35s;
}

/* InGameWarningPopup 만 1000 폭 */
.toast-popup--wide {
    width: 1000px;
}

/* YourTurnPopup 의 PlayerIcon > Icon (73x78) */
.toast-popup__icon {
    position: absolute;
    left: 102.5px;
    top: 41.5px;
    width: 73px;
    height: 78px;
    display: none;
    -unity-background-scale-mode: scale-to-fit;
}

.toast-popup__text {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    margin: 0;
    padding: 0;
    font-size: 64px;
    color: rgb(244, 248, 252);
    /* ChakraPetch 에는 한글이 없어 시스템 폰트로 폴백돼 커 보였다 (2026-09-19) */
    -unity-font-definition: url("/Assets/Contents/Font/GyeonggiTitle-Medium.ttf");
    -unity-font-style: normal;
    -unity-text-align: middle-center;
    white-space: normal;
}

/* 아이콘이 있는 경우(YourTurnPopup) 텍스트는 우측 464px 영역에 좌측 정렬 */
.toast-popup__text--with-icon {
    left: 215px;
    -unity-text-align: middle-left;
}

/* ---------- 팝업 공통 요소 ---------- */

/* 화면 전체를 덮는 어두운 막 (원본은 루트 Image + Mask 두 겹, 각각 검정 78.4%) */
.popup-dim {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.784);
}

/* URP + 6.6 backdrop-filter (2026-09-29) : 첫 막은 뒤 화면을 흐리게, 둘째 막은 옅게.
   예전 두 겹 78.4% (합 95% 어둡게) → 흐림 + 45% / 35% (합 64%) 로 흐린 맵이 비친다 */
.popup-dim--blur {
    backdrop-filter: blur(10px);
    background-color: rgba(0, 0, 0, 0.45);
}

.popup-dim--soft {
    background-color: rgba(0, 0, 0, 0.35);
}

/* 6.7 (2026-09-29) : popupBG.png / popupBG_glow.png 를 대신하는 공용 판 (위치·크기는 팝업별 __plate) */
.popup-plate {
    position: absolute;
    border-width: 2px;
    border-color: rgb(69, 73, 79);
    background-color: rgb(19, 23, 29);
    filter: drop-shadow(0px 0px 20px rgba(120, 225, 230, 0.15));
}

/* btn_bg.png (Simple) 계열 버튼 */
.popup-btn {
    position: absolute;
    margin: 0;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    transition-property: scale;
    transition-duration: 0.08s;
}

.popup-btn:hover { scale: 1.03 1.03; }
.popup-btn:active { scale: 0.97 0.97; }

.popup-btn__label {
    position: absolute;
    margin: 0;
    padding: 0;
    -unity-font-definition: url("/Assets/Contents/Font/GyeonggiTitle-Medium.ttf");
    -unity-font-style: normal;
    -unity-text-align: middle-center;
}

